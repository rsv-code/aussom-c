    // ---------- Static classes ----------

    @Test(name = "(static class) Instantiating a static class with new is rejected.")
    public staticNewRejected() {
        ex = false;
        try { o = new staticNoNew(); } catch (e) { ex = true; }
        return test.expect(ex, true);
    }

    @Test(name = "(static class) Instantiating a static extern stdlib class with new is rejected.")
    public staticExternNewRejected() {
        ex = false;
        try { o = new c(); } catch (e) { ex = true; }
        return test.expect(ex, true);
