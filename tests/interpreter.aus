	@Test(name = "(lang object) Empty object prints as {}.")
	public objectEmptyStr() { return test.expect("" + (new emptyObj()), "{}"); }
	
	/*
	 **********************************************************************
	 * json tests
	 *********************************************************************/
	@Test(name = "(lang json) JSON parse string.")
	public jsonParseString() {
		jstr = """
		{
			"firstName": "Tyler",
			"lastName": "Durden",
			"age": 35,
			"pi": 3.1415,
			"vet": true,
			"nextHouse": null,
			"months": ["November", "December", "January"],
			"loc": {
				"latitude": 38.7521,
				"longitude": -121.2880
			}
		}
		""";
		jobj = json.parse(jstr);
		return test.expect(jobj instanceof 'map', true);
	}

	@Test(name = "(lang json) JSON unpack object.")
	public jsonUnpack() {
		jstr = """
			{
				"type":"user",
				"members":{
					"firstName":{
						"type":"string",
						"value":"Tyler"
					},
					"lastName":{
						"type":"string",
						"value":"Durden"
					},
					"emailAddress":{
						"type":"email",
						"members":{
							"address":{
								"type":"string",
								"value":""
							}
						}
					},
					"dob": {
						"type":"Date",
						"value":"2015-01-01T00:00:00.000Z"
					}
				}
			}
		""";
		u = json.unpack(jstr);
		test.expect(u.dob.toString(), '2015-01-01T00:00:00.000Z');
		return test.expect(u instanceof 'user', true);
	}

	@Test(name = "(lang json) JSON escape object string.")
    public jsonEscapeObjectString() {
        jstr = """
        {
            "firstName": "Tyler",
            "lastName": "Durden",
            "age": 35
        }
        """;
        escapedString = json.escape(jstr);
        testStr = "\\n        {\\n            \\\"firstName\\\": \\\"Tyler\\\",\\n            \\\"lastName\\\": \\\"Durden\\\",\\n            \\\"age\\\": 35\\n        }\\n";
        test.expect(escapedString.trim(), testStr);
    }

    @Test(name = "(lang json) JSON escape array string.")
    public jsonEscapeArrayString() {
        jstr = """
        [
            "one",
            "two",
            "three",
            4,
            5,
            6
        ]
        """;
        escapedString = json.escape(jstr);
        testStr = "\\n        [\\n            \\\"one\\\",\\n            \\\"two\\\",\\n            \\\"three\\\",\\n            4,\\n            5,\\n            6\\n        ]\\n";
        test.expect(escapedString.trim(), testStr);
    }

    @Test(name = "(lang json) Pack and unpack JSON string")
    public jsonPackUnpack() {
        bf = new Buffer();
        bf.setString("Hello World");

        info = new Info();
        info.name = "Test";
        info.date = (new Date()).parse("2015-01-01T00:00:00.000Z", "yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
        info.buff = bf;

        packed = info.pack();
        unpacked = json.unpack(packed);

        test.expect(unpacked.date.toString(), "2015-01-01T00:00:00.000Z");
        test.expect(unpacked.buff.getString(), "Hello World");
    }

    @Test(name = "(lang json) Pack/unpack scalar members (int, double, bool, string).")
    public jsonPackScalars() {
        u = json.unpack((new packScalars()).pack());
        test.expect(u.i, 7);
        test.expect(u.d, 3.14);
        test.expect(u.b, true);
        return test.expect(u.s, "hi");
    }

    @Test(name = "(lang json) Pack/unpack null member.")
    public jsonPackNull() {
        u = json.unpack((new packNull()).pack());
        return test.expect(u.nul == null, true);
    }

    @Test(name = "(lang json) Pack/unpack list and map members.")
    public jsonPackCollections() {
        u = json.unpack((new packColl()).pack());
        test.expect(u.lst[0], 1);
        test.expect(u.lst[2], 3);
        test.expect(u.slst[1], "b");
        test.expect(u.mp['x'], 1);
        return test.expect(u.mp['y'], "two");
    }

    @Test(name = "(lang json) Pack/unpack sub-object member.")
    public jsonPackSubObject() {
        o = new packSub();
        o.sub = new packInner();
        u = json.unpack(o.pack());
        test.expect(u.sub instanceof 'packInner', true);
        test.expect(u.sub.tag, "inner");
        return test.expect(u.sub.n, 42);
    }

    @Test(name = "(lang json) Pack/unpack nested list of objects and map of objects.")
    public jsonPackNested() {
        o = new packNested();
        o.items = [ new packInner(), new packInner() ];
        o.items[1].tag = "second";
        o.lookup = { "only": new packInner() };
        o.lookup['only'].n = 99;
        u = json.unpack(o.pack());
        test.expect(u.items[0].tag, "inner");
        test.expect(u.items[1].tag, "second");
        test.expect(u.items[0] instanceof 'packInner', true);
        return test.expect(u.lookup['only'].n, 99);
    }

    @Test(name = "(lang json) Unpack requires a no-arg constructor.")
    public jsonPackNoArgRequired() {
        packed = (new packNeedsArgs(5)).pack();
        ex = false;
        try { u = json.unpack(packed); } catch (e) { ex = true; }
        return test.expect(ex, true);
    }

    @Test(name = "(lang json) Unpack list with a non-object item names the item type.")
    public jsonUnpackListBadItem() {
        ex = "";
        try { json.unpack('{"type":"list","value":[1]}'); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("at index 0, expecting JSON object but found 'java.lang.Long' instead."), true);
    }
	
	
	/***********************************************************************
	 * Buffer tests
	 *********************************************************************/
	@Test(name = "(lang Buffer) Buffer instantiate.")
	public bufferInstantiate() { this.buff = new Buffer(); return test.expectObject(this.buff, 'Buffer'); }

	// Buffer sizes are checked as 64-bit values before anything is
	// allocated. A size too large to address used to be narrowed to an int,
	// so new Buffer(4294967296) quietly produced an empty Buffer and
	// reported nothing.
	@Test(name = "(lang Buffer) Buffer size that cannot be addressed is refused.")
	public bufferSizeTooLarge() {
		ex = false;
		try { b = new Buffer(4294967296); } catch (e) { ex = true; }
		return test.expect(ex, true);
	}

	@Test(name = "(lang Buffer) Negative Buffer size is refused.")
	public bufferSizeNegative() {
		ex = false;
		try { b = new Buffer(-1); } catch (e) { ex = true; }
		return test.expect(ex, true);
	}

	@Test(name = "(lang Buffer) Reading a string past the end is refused.")
	public bufferStringPastEnd() {
		b = new Buffer(16);
		ex = false;
		try { s = b.getStringAt(64, 0); } catch (e) { ex = true; }
		return test.expect(ex, true);
	}

	public f9buff = null;

	/***********************************************************************
	 * Buffer 64-bit index tests (F9)
	 *********************************************************************/
	@Test(name = "(lang Buffer) An index too large for an int is refused.")
	public bufferIndexTooLarge() {
		this.f9buff = new Buffer(16);
		return test.expectThrowsMessage(::readIndexTooLarge, "out of range");
	}

	/** Callback for bufferIndexTooLarge; 2^32 used to narrow to 0. */
	public readIndexTooLarge() {
		this.f9buff.getByte(4294967296);
	}

	@Test(name = "(lang Buffer) An index that wraps to a negative int is refused.")
	public bufferIndexWrapsNegative() {
		this.f9buff = new Buffer(16);
		this.f9buff.setByte(5, 90);
		this.f9buff.readSeek(5);
		test.expectThrowsMessage(::readIndexWrapsNegative, "out of range");
		return test.expect(this.f9buff.getReadCursor(), 5);
	}

	/** Callback for bufferIndexWrapsNegative; 2^32-1 used to narrow to -1. */
	public readIndexWrapsNegative() {
		this.f9buff.getByte(4294967295);
	}

	@Test(name = "(lang Buffer) A negative index still reads at the cursor.")
	public bufferNegativeIndexReadsCursor() {
		this.f9buff = new Buffer(16);
		this.f9buff.setByte(5, 90);
		this.f9buff.readSeek(5);
		test.expect(this.f9buff.getByte(-1), 90);
		return test.expect(this.f9buff.getReadCursor(), 6);
	}

	@Test(name = "(lang Buffer) A seek index too large for an int is refused.")
	public bufferSeekIndexTooLarge() {
		this.f9buff = new Buffer(16);
		return test.expectThrowsMessage(::seekIndexTooLarge, "out of range");
	}

	/** Callback for bufferSeekIndexTooLarge. */
	public seekIndexTooLarge() {
		this.f9buff.readSeek(4294967296);
	}

	@Test(name = "(lang Buffer) Multi byte reads work at the last valid index.")
	public bufferMultiByteAtLastValidIndex() {
		this.f9buff = new Buffer(16);
		test.expectInt(this.f9buff.getShort(14));
		test.expectInt(this.f9buff.getInt(12));
		return test.expectInt(this.f9buff.getLong(8));
	}

	@Test(name = "(lang Buffer) A short read past the end is refused.")
	public bufferShortPastEnd() {
		this.f9buff = new Buffer(16);
		return test.expectThrowsMessage(::shortPastEnd, "Index out of bounds");
	}

	/** Callback for bufferShortPastEnd; 15 leaves only one byte. */
	public shortPastEnd() {
		this.f9buff.getShort(15);
	}

	@Test(name = "(lang Buffer) An int read past the end is refused.")
	public bufferIntPastEnd() {
		this.f9buff = new Buffer(16);
		return test.expectThrowsMessage(::intPastEnd, "Index out of bounds");
	}

	/** Callback for bufferIntPastEnd; 13 leaves only three bytes. */
	public intPastEnd() {
		this.f9buff.getInt(13);
	}

	@Test(name = "(lang Buffer) A long read past the end is refused.")
	public bufferLongPastEnd() {
		this.f9buff = new Buffer(16);
		return test.expectThrowsMessage(::longPastEnd, "Index out of bounds");
	}

	/** Callback for bufferLongPastEnd; 9 leaves only seven bytes. */
	public longPastEnd() {
		this.f9buff.getLong(9);
	}

	/***********************************************************************
	 * Security manager tests (F6, F7)
