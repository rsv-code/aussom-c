	@Test(name = "(extern) A host exception reports its own class and message.")
	public externExceptionRelaysCause() {
		test.expectThrowsMessage(::substrOutOfRange, "StringIndexOutOfBoundsException");
		return test.expectThrowsMessage(::substrOutOfRange, "out of bounds for length 3");
	}

	/** Callback for externExceptionRelaysCause. */
	public substrOutOfRange() {
		x = "abc".substr(-5);
	}

