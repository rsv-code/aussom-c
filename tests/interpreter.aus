	@Test(name = "(lang double) Double compare.")
	public doubleCompare() { return test.expect((32.0).compare(24.0), 1); }

	@Test(name = "(lang double) Double is infinite.")
	public doubleIsInfinite() { return test.expect(Double.posInfinity().isInfinite(), true); }

	@Test(name = "(lang double) Double is NaN.")
	public doubleIsNaN() { return test.expect(Double.nanVal().isNan(), true); }

	@Test(name = "(lang double) Double parse.")
