	@Test(name = "(lang Date) Date instantiate.")
	public dateInstantiate() { this.dt = new Date(); return test.expectObject(this.dt, 'Date'); }

	@Test(name = "(lang Date) Date set hours.")
	public dateSetHours() { this.dt.setHours(1); return test.expect(this.dt.getHours(), 1); }

	@Test(name = "(lang Date) Date set minutes.")
	public dateSetMinutes() { this.dt.setMinutes(30); return test.expect(this.dt.getMinutes(), 30); }

	@Test(name = "(lang Date) Date set seconds.")
	public dateSetSeconds() { this.dt.setSeconds(30); return test.expect(this.dt.getSeconds(), 30); }

	@Test(name = "(lang Date) Date set time.")
	public dateSetTime() { this.dt.setTime(3600); return test.expect(this.dt.getTime(), 3600); }

	@Test(name = "(lang Date) Date to string.")
	public dateToString() { return test.expectString(this.dt.toString()); }

	@Test(name = "(lang Date) Date parse.")
	public dateParse() { this.dt.parse("2014-12-31 23:59:59", "yyyy-MM-dd HH:mm:ss"); return test.expectObject(this.dt, 'Date'); }

	@Test(name = "(lang Date) Date parse 12-hour time with am/pm.")
	public dateParseAmPm() {
		d = new Date(); d.parse("2024-01-05 3:04 PM", "yyyy-MM-dd h:mm a");
		test.expect(d.getHours() == 15 && d.getMinutes() == 4, true);
		d.parse("2024-01-05 12:30 PM", "yyyy-MM-dd h:mm a");
		test.expect(d.getHours(), 12);
		d.parse("2024-01-05 12:30 AM", "yyyy-MM-dd h:mm a");
		test.expect(d.getHours(), 0);
		d.parse("2024-01-05 3 PM", "yyyy-MM-dd h a");
		return test.expect(d.getHours(), 15);
	}

	@Test(name = "(lang Date) Date parse 1-24, 0-11, milli-of-day and nano-of-day patterns.")
	public dateParseOtherHourFields() {
		d = new Date(); d.parse("2024-01-05 15:04", "yyyy-MM-dd kk:mm");
		test.expect(d.getHours(), 15);
		d.parse("2024-01-05 3:04 PM", "yyyy-MM-dd K:mm a");
		test.expect(d.getHours(), 15);
		d.parse("2024-01-05 54240000", "yyyy-MM-dd A");
		test.expect(d.toString(), "2024-01-05T15:04:00.000Z");
		d.parse("2024-01-05 54240000000000", "yyyy-MM-dd N");
		return test.expect(d.toString(), "2024-01-05T15:04:00.000Z");
	}

	@Test(name = "(lang Date) Date parse with an offset, with and without a time.")
	public dateParseOffset() {
		d = new Date(); d.parse("2024-01-05 3:04 PM -05:00", "yyyy-MM-dd h:mm a XXX");
		test.expect(d.toString(), "2024-01-05T20:04:00.000Z");
		d.parse("2024-01-05 -05:00", "yyyy-MM-dd XXX");
		return test.expect(d.toString(), "2024-01-05T05:00:00.000Z");
	}

	@Test(name = "(lang Date) Date parse returns an error for bad or ambiguous times.")
	public dateParseBadTime() {
		d = new Date();
		bad = 0;
		try { d.parse("2024-01-05 13:04 PM", "yyyy-MM-dd h:mm a"); } catch (e) { if (e.getText().startsWith("Date.parse(): Parse exception.")) { bad++; } }
		try { d.parse("2024-01-05 3:04", "yyyy-MM-dd h:mm"); } catch (e) { if (e.getText().startsWith("Date.parse(): Parse exception.")) { bad++; } }
		try { d.parse("15:04", "HH:mm"); } catch (e) { if (e.getText().startsWith("Date.parse(): Parse exception.")) { bad++; } }
		return test.expect(bad, 3);
	}

	@Test(name = "(lang Date) Date format.")
	public dateFormat() { return test.expect(this.dt.format("yyyy-MM-dd HH:mm:ss"), "2014-12-31 23:59:59"); }

	@Test(name = "(lang Date) Date is epoch.")
	public dateIsEpoch() { this.dt = new Date(0); return test.expect(this.dt.isEpoch(), true); }

	@Test(name = "(lang Date) JSON pack/unpack round-trip preserves epoch millis.")
	public dateJsonRoundTrip() {
		d = new Date();
		d.parse("2024-02-15 08:30:00", "yyyy-MM-dd HH:mm:ss");
		packed = d.pack();
		unpacked = json.unpack(packed);
		return test.expect(unpacked.getTime(), d.getTime());
	}

	@Test(name = "(lang Date) toString produces ISO 8601 with Z suffix at UTC.")
	public dateToStringIso() {
		d = new Date(0);
		return test.expect(d.toString(), "1970-01-01T00:00:00.000Z");
	}

	@Test(name = "(lang Date) setHours / getHours round-trip at UTC.")
	public dateHoursRoundTrip() {
		d = new Date(0);
		d.setHours(14);
		return test.expect(d.getHours(), 14);
	}

