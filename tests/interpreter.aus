	 * string tests
	 *********************************************************************/
	@Test(name = "(lang string) String char at.")
	public stringCharAt() { return test.expect("Tyler".charAt(1), 'y'); }

	@Test(name = "(lang string) String compare.")
	public stringCompare() { return test.expect("Ty".compare("Tyler"), -3); }

	@Test(name = "(lang string) String compare ignore case.")
	public stringCompareICase() { return test.expect("Tyler".compareICase("tyler"), 0); }

	@Test(name = "(lang string) String concat.")
	public stringConcat() { return test.expect("Ty".concat("ler"), "Tyler"); }

	@Test(name = "(lang string) String contains.")
	public stringContains() { return test.expect("Tyler".contains("yl"), true); }

	@Test(name = "(lang string) String ends with.")
	public stringEndsWith() { return test.expect("Tyler".endsWith("er"), true); }

	@Test(name = "(lang string) String equals.")
	public stringEquals() { return test.expect("Tyler".equals("Tyler"), true); }

	@Test(name = "(lang string) String equals ignore case.")
	public stringEqualsICase() { return test.expect("Tyler".equalsICase("tyler"), true); }

	@Test(name = "(lang string) String index of.")
	public stringIndexOf() { return test.expect("Tyler".indexOf("ler"), 2); }

	@Test(name = "(lang string) String index of start.")
	public stringIndexOfStart() { return test.expect("Tyler Durden".indexOfStart("e", 5), 10); }

	@Test(name = "(lang string) String is empty.")
	public stringIsEmpty() { return test.expect("Tyler".isEmpty(), false); }

	@Test(name = "(lang string) String last index of.")
	public stringLastIndexOf() { return test.expect("Tyler Durden".lastIndexOf("e"), 10); }

	@Test(name = "(lang string) String last index of start.")
	public stringLastIndexOfStart() { return test.expect("Tyler Durden".lastIndexOfStart("e", 5), 3); }

	@Test(name = "(lang string) String matches.")
	public stringMatches() { return test.expect("Tyler".matches("^Ty.*"), true); }

	@Test(name = "(lang string) String replace.")
	public stringReplace() { return test.expect("Tyler Durdon".replace("on", "en"), "Tyler Durden"); }

	@Test(name = "(lang string) String replace first regex.")
	public stringReplaceFirstRegex() { return test.expect("Tyler".replaceFirstRegex("T.", "Ty"), "Tyler"); }

	@Test(name = "(lang string) String replace regex.")
	public stringReplaceRegex() { return test.expect("Tyler Durden".replaceRegex("e.", "on"), "Tylon Durdon"); }

	@Test(name = "(lang string) String split.")
	public stringSplit() { return test.expect("one,two,three".split(",")[1], "two"); }

	// The regex-backed string methods now read their subject through the
	// engine's metering so a host can budget, pause or cancel a match.
	// These pin the no-op direction of that change: with no budget set
	// (the default) every result must be exactly what it was before.
	@Test(name = "(lang string) String split keeps blank sections when asked.")
	public stringSplitBlanks() { return test.expect(#("a,b,,c".split(",", true)), 4); }

	@Test(name = "(lang string) String split drops blank sections by default.")
	public stringSplitNoBlanks() { return test.expect(#("a,b,,c".split(",")), 3); }

	@Test(name = "(lang string) String split on a regex delimiter.")
	public stringSplitRegex() { return test.expect("a1b22c".split("[0-9]+")[2], "c"); }

	@Test(name = "(lang string) String matches with no match.")
	public stringMatchesFalse() { return test.expect("Tyler".matches("^Zz.*"), false); }

	@Test(name = "(lang string) String replace regex with no match is unchanged.")
	public stringReplaceRegexNoMatch() { return test.expect("Tyler".replaceRegex("[0-9]", "#"), "Tyler"); }

	@Test(name = "(lang string) String starts with.")
	public stringStartsWith() { return test.expect("Tyler Durden".startsWith("Tyler "), true); }

	@Test(name = "(lang string) String sub string.")
	public stringSubstr() { return test.expect("Tyler".substr(2), "ler"); }

	@Test(name = "(lang string) String sub string end.")
	public stringSubstrEnd() { return test.expect("Tyler".substr(2, 4), "le"); }

	@Test(name = "(lang string) String to lower case.")
	public stringToLower() { return test.expect("Tyler".toLower(), "tyler"); }

	@Test(name = "(lang string) String to upper case.")
	public stringToUpper() { return test.expect("Tyler".toUpper(), "TYLER"); }

	@Test(name = "(lang string) String trim.")
	public stringTrim() { return test.expect(" Tyler ".trim(), "Tyler"); }

	@Test(name = "(lang string) String format positional sequential.")
	public stringFormatPositional() { return test.expect("Hello {}, you are {}.".format("Bob", 42), "Hello Bob, you are 42."); }

	@Test(name = "(lang string) String format positional indexed and reused.")
	public stringFormatIndexed() { return test.expect("{0}-{1}-{0}".format("a", "b"), "a-b-a"); }

	@Test(name = "(lang string) String format named from map.")
	public stringFormatNamed() { return test.expect("{greeting}, {name}!".format({ "greeting": "Hi", "name": "Bob" }), "Hi, Bob!"); }

	@Test(name = "(lang string) String format escaped braces.")
	public stringFormatEscaped() { return test.expect("literal {{ and }} val={}".format(7), "literal { and } val=7"); }

	@Test(name = "(lang string) String format too few args throws.")
	public stringFormatTooFew() { ex = false; try { x = "{} {}".format("only"); } catch (e) { ex = true; } return test.expect(ex, true); }

	@Test(name = "(lang string) String format renders a list compactly.")
	public stringFormatList() { return test.expect("items={}".format([ 1, 2, 3 ]), "items=[1,2,3]"); }

	@Test(name = "(lang string) String format renders a map compactly.")
	public stringFormatMap() { return test.expect("m={}".format({ "a": 1 }), """m={"a":1}"""); }

	@Test(name = "(lang string) String to JSON.")
	public stringToJson() { return test.expect("Tyler Durdon".toJson(), "\"Tyler Durdon\""); }

	@Test(name = "(lang string) String parseInt.")
	public stringParseInt() { return test.expect("42".parseInt(), 42); }

	@Test(name = "(lang string) String parseInt negative.")
	public stringParseIntNeg() { return test.expect("-7".parseInt(), -7); }

	@Test(name = "(lang string) String parseInt with radix.")
	public stringParseIntRadix() { return test.expect("ff".parseInt(16), 255); }

	@Test(name = "(lang string) String parseInt throws on non-numeric.")
	public stringParseIntThrows() {
		threw = false;
		try { x = "abc".parseInt(); } catch (e) { threw = true; }
		return test.expect(threw, true);
	}

	@Test(name = "(lang string) String parseDouble.")
	public stringParseDouble() { return test.expect("3.14".parseDouble(), 3.14); }

	@Test(name = "(lang string) String parseDouble negative.")
	public stringParseDoubleNeg() { return test.expect("-2.5".parseDouble(), -2.5); }

	@Test(name = "(lang string) String parseDouble throws on non-numeric.")
	public stringParseDoubleThrows() {
		threw = false;
		try { x = "abc".parseDouble(); } catch (e) { threw = true; }
		return test.expect(threw, true);
	}

	@Test(name = "(lang string) String parseBool true.")
	public stringParseBoolTrue() { return test.expect("true".parseBool(), true); }

	@Test(name = "(lang string) String parseBool false.")
	public stringParseBoolFalse() { return test.expect("false".parseBool(), false); }

	/***********************************************************************
	 * Scientific-notation numeric literals.
	 *
	 * The lexer's number rule accepts an optional [eE][+-]?[0-9]+ exponent.
	 * Any literal containing 'e', 'E', or '.' becomes a DOUBLE token; bare
	 * integers stay INT. Identifiers that happen to start with a letter
	 * (e1, e_value) still tokenize as identifiers.
	 *********************************************************************/

	@Test(name = "(scientific notation) Lower-case e literal.")
	public sciLower() { return test.expect(1e3, 1000.0); }

	@Test(name = "(scientific notation) Upper-case E literal.")
	public sciUpper() { return test.expect(1E3, 1000.0); }

	@Test(name = "(scientific notation) Decimal mantissa with exponent.")
	public sciDecimal() { return test.expect(1.5e2, 150.0); }

	@Test(name = "(scientific notation) Negative exponent.")
	public sciNegExp() { return test.expectClose(1e-4, 0.0001, 1e-9); }

	@Test(name = "(scientific notation) Explicit positive exponent.")
	public sciPosExp() { return test.expect(1e+3, 1000.0); }

	@Test(name = "(scientific notation) Large value.")
	public sciLarge() { return test.expectClose(1.0E30, 1.0E30, 1.0E21); }

	@Test(name = "(scientific notation) Identifier starting with letter still parses.")
	public sciIdentUnaffected() { e1 = 7; return test.expect(e1, 7); }

	/***********************************************************************
	 * String comparison operators (<, >, <=, >=).
	 *
	 * Two AussomString operands are compared lexicographically with
	 * String.compareTo (Unicode code unit order), matching string.compare().
	 * Mixed-type operands still raise INVALID_COMPARISON.
	 *********************************************************************/

	// Less than (<)
	@Test(name = "(string compare) Less than true when left precedes right.")
	public stringLtTrue() { return test.expect("apple" < "banana", true); }

	@Test(name = "(string compare) Less than false when left follows right.")
	public stringLtFalseWhenAfter() { return test.expect("banana" < "apple", false); }

	@Test(name = "(string compare) Less than false when strings are equal.")
	public stringLtFalseWhenEqual() { return test.expect("apple" < "apple", false); }

	@Test(name = "(string compare) Less than orders ISO date strings.")
	public stringLtIsoDates() { return test.expect("2026-01-15" < "2026-04-27", true); }

	@Test(name = "(string compare) Less than treats empty string as smallest.")
	public stringLtEmpty() { return test.expect("" < "a", true); }

	@Test(name = "(string compare) Less than is case sensitive.")
	public stringLtCaseSensitive() { return test.expect("Z" < "a", true); }

	// Greater than (>)
	@Test(name = "(string compare) Greater than true when left follows right.")
	public stringGtTrue() { return test.expect("banana" > "apple", true); }

	@Test(name = "(string compare) Greater than false when left precedes right.")
	public stringGtFalseWhenBefore() { return test.expect("apple" > "banana", false); }

	@Test(name = "(string compare) Greater than false when strings are equal.")
	public stringGtFalseWhenEqual() { return test.expect("apple" > "apple", false); }

	@Test(name = "(string compare) Greater than orders ISO date strings.")
	public stringGtIsoDates() { return test.expect("2026-04-27" > "2026-01-15", true); }

	// Less than or equal (<=)
	@Test(name = "(string compare) Less than equal true when strings are equal.")
	public stringLeTrueWhenEqual() { return test.expect("apple" <= "apple", true); }

	@Test(name = "(string compare) Less than equal true when left precedes right.")
	public stringLeTrueWhenBefore() { return test.expect("apple" <= "banana", true); }

	@Test(name = "(string compare) Less than equal false when left follows right.")
	public stringLeFalseWhenAfter() { return test.expect("banana" <= "apple", false); }

	// Greater than or equal (>=)
	@Test(name = "(string compare) Greater than equal true when strings are equal.")
	public stringGeTrueWhenEqual() { return test.expect("apple" >= "apple", true); }

	@Test(name = "(string compare) Greater than equal true when left follows right.")
	public stringGeTrueWhenAfter() { return test.expect("banana" >= "apple", true); }

	@Test(name = "(string compare) Greater than equal false when left precedes right.")
	public stringGeFalseWhenBefore() { return test.expect("apple" >= "banana", false); }

	// Unicode \uXXXX escape in string literals. The lexer should decode
	// \uXXXX to the matching code point in all string forms. Without the
	// fix the backslash is silently dropped and the literal "u" plus the
	// hex digits stay in the string -- so length and equality assertions
	// against the expected decoded form will fail.
	@Test(name = "(string escape) Unicode \u0041 in double-quote string -> 'A'.")
	public stringEscapeUnicodeDouble() { return test.expect("\u0041", "A"); }

	@Test(name = "(string escape) Unicode \u0061 in double-quote string -> 'a'.")
	public stringEscapeUnicodeDoubleLower() { return test.expect("\u0061", "a"); }

	@Test(name = "(string escape) Unicode \u0041 in single-quote string -> 'A'.")
	public stringEscapeUnicodeSingle() { return test.expect('\u0041', "A"); }

	@Test(name = "(string escape) Unicode \u0041 in triple-quote string -> 'A'.")
	public stringEscapeUnicodeTriple() { return test.expect("""\u0041""", "A"); }

	@Test(name = "(string escape) Multiple unicode escapes -> 'ABC'.")
	public stringEscapeUnicodeMultiple() { return test.expect("\u0041\u0042\u0043", "ABC"); }

	@Test(name = "(string escape) Unicode escape mid-string -> length 4.")
	public stringEscapeUnicodeMidLen() { return test.expect(#"caf\u00e9", 4); }

	@Test(name = "(string escape) Unicode \u2022 (bullet) length 1.")
	public stringEscapeUnicodeBulletLen() { return test.expect(#"\u2022", 1); }

	@Test(name = "(string escape) Unicode escape with surrounding text -> 'Hi!'.")
	public stringEscapeUnicodeSurround() { return test.expect("H\u0069!", "Hi!"); }
	
	/***********************************************************************
	 * list tests
	 *********************************************************************/
	@Test(name = "(lang list) List create.")
	public listCreate() { this.tlist = new list(); return test.expectList(this.tlist); }

	@Test(name = "(lang list) List add.")
	public listAdd() { this.tlist.add("one"); return test.expect(#this.tlist, 1); }

	@Test(name = "(lang list) List add all.")
	public listAddAll() { tmp = []; tmp @= "two"; tmp @= "three"; this.tlist.addAll(tmp); return test.expect(#this.tlist, 3); }

	@Test(name = "(lang list) List add all at.")
	public listAddAllAt() { tmp = []; tmp @= "two"; tmp @= "three"; this.tlist.addAllAt(tmp, 1); return test.expect(this.tlist[2], 'three'); }

	@Test(name = "(lang list) List clone.")
	public listClone() { tmp = this.tlist.clone(); return test.expect(#tmp, 5); }

	@Test(name = "(lang list) List contains object reference.")
	public listContainsObjRef() { tmp = "hi"; this.tlist @= tmp; return test.expect(this.tlist.containsObjRef(tmp), true); }

	@Test(name = "(lang list) List contains.")
	public listContains() { return test.expect(this.tlist.contains('hi'), true); }

	@Test(name = "(lang list) List get.")
	public listGet() { return test.expect(this.tlist.get(#this.tlist - 1), "hi"); }

	@Test(name = "(lang list) List index of.")
	public listIndexOf() { tmp = "howdy"; this.tlist @= tmp; return test.expect(this.tlist.indexOf("howdy"), 6); }

	@Test(name = "(lang list) List is empty.")
	public listIsEmpty() { return test.expect(this.tlist.isEmpty(), false); }

	@Test(name = "(lang list) List remove.")
	public listRemove() { lst = [ "a", "b", "howdy" ]; lst.remove("howdy"); return test.expect(#lst, 2); }

	@Test(name = "(lang list) List remove at.")
	public listRemoveAt() { this.tlist.removeAt(6); return test.expect(#this.tlist, 6); }

	@Test(name = "(lang list) List remove all.")
	public listRemoveAll() { lst = [ "one", "two", "three" ]; rem = [ "one", "two" ]; lst.removeAll(rem); return test.expect(#lst, 1); }

	@Test(name = "(lang list) List retain all.")
	public listRetainAll() { lst = [ "one", "two", "three" ]; lst.retainAll([ "one", "two" ]); this.tlist.clear(); this.tlist @= "one"; this.tlist @= "two"; return test.expect(#lst, 2); }

	@Test(name = "(lang list) List set.")
	public listSet() { this.tlist @= "five"; this.tlist.set(2, "three"); return test.expect(this.tlist[2], "three"); }

	@Test(name = "(lang list) List size.")
	public listSize() { return test.expect(this.tlist.size(), 3); }

	@Test(name = "(lang list) List sub list.")
	public listSubList() { tmp = this.tlist.subList(0, 2); return test.expect(#tmp, 2); }

	@Test(name = "(lang list) List sort.")
	public listSort() { tmp = [ "banana", "apple", "cherry" ]; tmp.sort(); return test.expect(tmp[0], "cherry"); }

	@Test(name = "(lang list) List sort ascending.")
	public listSortAsc() { tmp = [ "banana", "apple", "cherry" ]; tmp.sortAsc(); return test.expect(tmp[0], "apple"); }

	@Test(name = "(lang list) List reverse.")
	public listReverse() { tmp = [ 1, 2, 3 ]; tmp.reverse(); return test.expect(tmp[0], 3); }

	@Test(name = "(lang list) List reverse returns this.")
	public listReverseReturnsThis() { tmp = [ 1, 2, 3 ]; r = tmp.reverse(); return test.expect(r[2], 1); }

	@Test(name = "(lang list) List sort custom.")
	public listSortCustom() {
		dogs = [];
		dogs @= new dog("Labrador");
		dogs @= new dog("Maltese");
		dogs @= new dog("German Shepherd");
		sortedDogs = dogs.sortCustom(::customComparator);
		// TODO: Add list.join()!
		return test.expect(sortedDogs[2].breed, "Maltese");
	}
	public customComparator(object d1, object d2) { return d1.breed.compare(d2.breed); }

	/***********************************************************************
	 * sort()/sortAsc() coverage for each type in AussomListComparator.
	 * sort() is expected to order descending and sortAsc() ascending.
	 *********************************************************************/
	@Test(name = "(lang list) List sort int descending.")
	public listSortInt() { tmp = [ 3, 1, 2 ]; tmp.sort(); return test.expect(tmp[0], 3); }

	@Test(name = "(lang list) List sortAsc int ascending.")
	public listSortAscInt() { tmp = [ 3, 1, 2 ]; tmp.sortAsc(); return test.expect(tmp[0], 1); }

	@Test(name = "(lang list) List sort double descending.")
	public listSortDouble() { tmp = [ 3.5, 1.5, 2.5 ]; tmp.sort(); return test.expect(tmp[0], 3.5); }

	@Test(name = "(lang list) List sortAsc double ascending.")
	public listSortAscDouble() { tmp = [ 3.5, 1.5, 2.5 ]; tmp.sortAsc(); return test.expect(tmp[0], 1.5); }

	@Test(name = "(lang list) List sort bool descending.")
	public listSortBool() { tmp = [ false, true, false ]; tmp.sort(); return test.expect(tmp[0], true); }

	@Test(name = "(lang list) List sortAsc bool ascending.")
	public listSortAscBool() { tmp = [ true, false, true ]; tmp.sortAsc(); return test.expect(tmp[0], false); }

	@Test(name = "(lang list) List sort mixed int/double descending.")
	public listSortMixedNum() { tmp = [ 3, 1.5, 2 ]; tmp.sort(); return test.expect(tmp[0], 3); }

	@Test(name = "(lang list) List sortAsc mixed int/double ascending.")
	public listSortAscMixedNum() { tmp = [ 3, 1.5, 2 ]; tmp.sortAsc(); return test.expect(tmp[0], 1.5); }

	@Test(name = "(lang list) List sort object descending by class name.")
	public listSortObject() { tmp = [ new cat(), new dog("lab") ]; tmp.sort(); return test.expect(tmp[0] instanceof 'dog', true); }

	@Test(name = "(lang list) List sortAsc object ascending by class name.")
	public listSortAscObject() { tmp = [ new dog("lab"), new cat() ]; tmp.sortAsc(); return test.expect(tmp[0] instanceof 'cat', true); }

	@Test(name = "(lang list) List sort nested list descending by string.")
	public listSortList() { tmp = [ [ 3 ], [ 1 ], [ 2 ] ]; tmp.sort(); return test.expect(tmp[0][0], 3); }

	@Test(name = "(lang list) List sortAsc nested list ascending by string.")
	public listSortAscList() { tmp = [ [ 3 ], [ 1 ], [ 2 ] ]; tmp.sortAsc(); return test.expect(tmp[0][0], 1); }

	@Test(name = "(lang list) List sort map descending by string.")
	public listSortMap() { m1 = {}; m1['a'] = 3; m2 = {}; m2['a'] = 1; tmp = [ m1, m2 ]; tmp.sort(); return test.expect(tmp[0]['a'], 3); }

	@Test(name = "(lang list) List sortAsc map ascending by string.")
	public listSortAscMap() { m1 = {}; m1['a'] = 3; m2 = {}; m2['a'] = 1; tmp = [ m1, m2 ]; tmp.sortAsc(); return test.expect(tmp[0]['a'], 1); }

	public cbAaa() { return "A"; }
	public cbZzz() { return "Z"; }

	@Test(name = "(lang list) List sort callback descending by string.")
	public listSortCallback() { tmp = [ ::cbAaa, ::cbZzz ]; tmp.sort(); return test.expect(tmp[0].call(), "Z"); }

	@Test(name = "(lang list) List sortAsc callback ascending by string.")
	public listSortAscCallback() { tmp = [ ::cbZzz, ::cbAaa ]; tmp.sortAsc(); return test.expect(tmp[0].call(), "A"); }

	@Test(name = "(lang list) List clear.")
	public listClear() { this.tlist.clear(); return test.expect(#this.tlist, 0); }

	@Test(name = "(lang list) List to JSON.")
	public listToJson() { tmp = [ 1, 'dog', true ]; return test.expect(tmp.toJson(), """[1,"dog",true]"""); }
	
	/***********************************************************************
	 * map tests
	 *********************************************************************/
	@Test(name = "(lang map) Map create.")
	public mapCreate() { this.tmap = new map(); return test.expectMap(this.tmap); }

	@Test(name = "(lang map) Map contains key.")
	public mapContainsKey() { this.tmap['name'] = "Tyler"; return test.expect(this.tmap.containsKey('name'), true); }

	@Test(name = "(lang map) Map contains value.")
	public mapContainsValue() { val = 'programmer'; this.tmap['occupation'] = val; return test.expect(this.tmap.containsVal('programmer'), true); }

	@Test(name = "(lang map) Map get.")
	public mapGet() { return test.expect(this.tmap.get('occupation'), 'programmer'); }

	@Test(name = "(lang map) Map getd default val.")
	public mapGetd() { return test.expect(this.tmap.getd('hobby', 'soap maker'), 'soap maker'); }

	@Test(name = "(lang map) Map is empty.")
	public mapIsEmpty() { return test.expect(this.tmap.isEmpty(), false); }

	@Test(name = "(lang map) Map key set.")
	public mapKeySet() { return test.expect(#this.tmap.keySet(), 2); }

	@Test(name = "(lang map) Map put.")
	public mapPut() { this.tmap.put('age', 32); return test.expect(this.tmap['age'], 32); }

	@Test(name = "(lang map) Map put all.")
	public mapPutAll() { tm = {}; tm['1'] = 'one'; tm['2'] = 'two'; this.tmap.putAll(tm); return test.expect(this.tmap['1'], 'one'); }

	@Test(name = "(lang map) Map put if absent.")
	public mapPutIfAbsent() { this.tmap.putIfAbsent('2', 'three'); return test.expect(this.tmap['2'], 'two'); }

	@Test(name = "(lang map) Map remove.")
	public mapRemove() { this.tmap.remove('2'); return test.expect(this.tmap.containsKey('2'), false); }

	@Test(name = "(lang map) Map size.")
	public mapSize() { return test.expect(this.tmap.size(), #this.tmap); }

	@Test(name = "(lang map) Map values.")
	public mapValues() { mp = {}; mp['name'] = 'Tyler'; return test.expect(mp.values()[0], 'Tyler'); }

	@Test(name = "(lang map) Map clear.")
	public mapClear() { this.tmap.clear(); return test.expect(#this.tmap, 0); }

	@Test(name = "(lang map) Map to JSON.")
	public mapToJson() { tmp = { name: "Tyler", age: 35 }; return test.expect(tmp.toJson(), """{"name":"Tyler","age":35}"""); }
	
