	@Test(name = "(util hex) Encode/Decode hex value.")
	public hexEncodeDecode() {
	    buff = new Buffer();
	    buff.addString("Aussom");
	    encodedStr = hex.encode(buff);
	    decodedBuff = hex.decode(encodedStr);
	    return test.expect(decodedBuff.getString().startsWith("Aussom"), true);
	}

    @Test(name = "(util base64) Encode/Decode string base64 value.")
    public base64EncodeDecode() {
        encodedStr = base64.encode("Aussom");
        decodedStr = base64.decode(encodedStr);
        return test.expect(decodedStr, "Aussom");
    }

    @Test(name = "(util base64) Encode string to a known base64 vector.")
    public base64EncodeVector() {
        return test.expect(base64.encode("user:pass"), "dXNlcjpwYXNz");
    }

    @Test(name = "(util base64) Decode a known base64 vector to string.")
    public base64DecodeVector() {
        return test.expect(base64.decode("QXVzc29t"), "Aussom");
    }

    @Test(name = "(util base64) String round trip preserves the value.")
    public base64StringRoundTrip() {
        return test.expect(base64.decode(base64.encode("Hello, World!")), "Hello, World!");
    }

    @Test(name = "(util base64) Encode an empty string.")
    public base64EncodeEmpty() {
        return test.expect(base64.encode(""), "");
    }

    @Test(name = "(util base64) Encode/Decode binary base64 value.")
