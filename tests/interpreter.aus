	@Test(name = "(lang Date) getYear.")
	public dateGetYear() {
		d = new Date(); d.parse("2024-03-15", "yyyy-MM-dd");
		return test.expect(d.getYear(), 2024);
	}

	@Test(name = "(lang Date) getMonth is 1-12.")
	public dateGetMonth() {
		d = new Date(); d.parse("2024-03-15", "yyyy-MM-dd");
		return test.expect(d.getMonth(), 3);
	}

	@Test(name = "(lang Date) getDayOfMonth.")
	public dateGetDayOfMonth() {
		d = new Date(); d.parse("2024-03-15", "yyyy-MM-dd");
		return test.expect(d.getDayOfMonth(), 15);
	}

	@Test(name = "(lang Date) getDayOfWeek is ISO (Mon=1, 2024-03-15 is Friday=5).")
	public dateGetDayOfWeek() {
		d = new Date(); d.parse("2024-03-15", "yyyy-MM-dd");
		return test.expect(d.getDayOfWeek(), 5);
	}

	@Test(name = "(lang Date) getDayOfYear (2024-03-15 is day 75).")
	public dateGetDayOfYear() {
		d = new Date(); d.parse("2024-03-15", "yyyy-MM-dd");
		return test.expect(d.getDayOfYear(), 75);
	}

	@Test(name = "(lang Date) getWeekOfYear (ISO week 11).")
	public dateGetWeekOfYear() {
		d = new Date(); d.parse("2024-03-15", "yyyy-MM-dd");
		return test.expect(d.getWeekOfYear(), 11);
	}

	@Test(name = "(lang Date) getMilliseconds is the 0-999 sub-second part.")
	public dateGetMilliseconds() {
		d = new Date(); d.parse("2024-03-15 08:30:45.123", "yyyy-MM-dd HH:mm:ss.SSS");
		return test.expect(d.getMilliseconds(), 123);
	}

