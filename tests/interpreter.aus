    public staticNewChainedRejected() {
        ex = false;
        try { v = (new staticNoNew()).sfn(); } catch (e) { ex = true; }
        return test.expect(ex, true);
    }

    @Test(name = "(static class) reflect.instantiate on a static class is rejected.")
    public staticReflectInstantiateRejected() {
        ex = false;
        try { o = reflect.instantiate("staticNoNew"); } catch (e) { ex = true; }
