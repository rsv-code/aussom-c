	@Test(name = "(lang SecurityManager) A new object carries its own policy, not the engine's.")
	public secmanInstIsNotEnginePolicy() {
		sman = new SecurityManager();
		test.expect(secman.getProp("aussom.script.mode.enable"), true);
		return test.expect(sman.getProp("aussom.script.mode.enable"), false);
	}

	@Test(name = "(lang secman) A denied view returns null rather than failing.")
	public secmanDeniedViewReturnsNull() {
		test.expect(secman.getProp("os.info.view"), false);
		return test.expectNull(sys.getOsName());
	}

	@Test(name = "(lang secman) Properties read back with their own types.")
	public secmanPropertyTypes() {
		test.expectBool(secman.getProp("securitymanager.instantiate"));
		test.expectInt(secman.getProp("aussom.limit.call.depth"));
		return test.expectList(secman.getProp("aussom.extern.allowed"));
	}

