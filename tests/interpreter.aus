        return test.expect(p.callPriv(), "priv:1");
    }

    @Test(name = "(access) Private extern function is a parse error.")
    public accessPrivateExternRejected() {
        src = "extern class pe : com.aussom.stdlib.ABuffer { public pe() { } private extern size(); }";
        ex = "";
