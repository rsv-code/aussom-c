	 @Test(name = "(object access) Inherited private member denied (member variable).")
	 public objectAccessInheritedMemVarPri() { this.obj = new inhDerived(); ex = false; try { t = this.obj.baseSecret; } catch(e) { ex = true; } return test.expect(ex, true); }

	 @Test(name = "(object access) Inherited public member allowed.")
	 public objectAccessInheritedPub() { l = new inhDerived(); ex = false; try { t = l.basePublic; } catch(e) { ex = true; } return test.expect(ex, false); }

