	/* ---- Comparison and difference ---- */

	@Test(name = "(lang Date) isBefore.")
	public dateIsBefore() {
		a = new Date(1000); b = new Date(2000);
		return test.expect(a.isBefore(b), true);
	}

	@Test(name = "(lang Date) isAfter.")
	public dateIsAfter() {
		a = new Date(1000); b = new Date(2000);
		return test.expect(b.isAfter(a), true);
	}

	@Test(name = "(lang Date) isSame.")
	public dateIsSame() {
		a = new Date(1500); b = new Date(1500);
		return test.expect(a.isSame(b), true);
	}

	@Test(name = "(lang Date) compare returns -1 / 0 / 1.")
	public dateCompare() {
		a = new Date(1000); b = new Date(2000); same = new Date(1000);
		return test.expect(a.compare(b) == -1 && b.compare(a) == 1 && a.compare(same) == 0, true);
	}

	@Test(name = "(lang Date) between in days (Other minus this).")
	public dateBetweenDays() {
		a = new Date(); a.parse("2024-03-15", "yyyy-MM-dd");
		b = new Date(); b.parse("2024-03-25", "yyyy-MM-dd");
		return test.expect(a.between(b, "days"), 10);
	}

	@Test(name = "(lang Date) between in months.")
	public dateBetweenMonths() {
		a = new Date(); a.parse("2024-01-15", "yyyy-MM-dd");
		b = new Date(); b.parse("2024-03-15", "yyyy-MM-dd");
		return test.expect(a.between(b, "months"), 2);
	}

	@Test(name = "(lang Date) between defaults to millis.")
	public dateBetweenDefaultMillis() {
		a = new Date(1000); b = new Date(3500);
		return test.expect(a.between(b), 2500);
	}

	@Test(name = "(lang Date) between accepts a dateunit enum value.")
	public dateBetweenEnumUnit() {
		a = new Date(); a.parse("2024-03-15", "yyyy-MM-dd");
		b = new Date(); b.parse("2024-03-25", "yyyy-MM-dd");
		return test.expect(a.between(b, dateunit.days), 10);
	}

	@Test(name = "(lang Date) between with an unknown unit throws.")
	public dateBetweenBadUnit() {
		a = new Date(1000); b = new Date(2000);
		threw = false;
		try { a.between(b, "fortnights"); } catch (e) { threw = true; }
		return test.expect(threw, true);
	}

	/* ---- Current time and copying ---- */

	@Test(name = "(lang Date) now sets to the current instant (not epoch).")
	public dateNow() {
		d = new Date(); d.now();
		return test.expect(d.isEpoch(), false);
	}

	@Test(name = "(lang Date) now returns this for chaining.")
	public dateNowFluent() {
		return test.expectObject(new Date().now(), 'Date');
	}

	@Test(name = "(lang Date) copy has the same instant.")
	public dateCopyEqual() {
		a = new Date(1710460800000);
		b = a.copy();
		return test.expect(b.getTime(), a.getTime());
	}

	@Test(name = "(lang Date) copy is independent (mutating the copy leaves the original).")
	public dateCopyIndependent() {
		a = new Date(); a.parse("2024-03-15", "yyyy-MM-dd");
		b = a.copy();
		b.addDays(5);
		return test.expect(a.getDayOfMonth(), 15);
	}

	/* ---- Day boundaries ---- */

	@Test(name = "(lang Date) startOfDay zeroes the time.")
	public dateStartOfDay() {
		d = new Date(); d.parse("2024-03-15 08:30:45", "yyyy-MM-dd HH:mm:ss");
		d.startOfDay();
		return test.expect(d.getHours() == 0 && d.getMinutes() == 0 && d.getSeconds() == 0, true);
	}

	@Test(name = "(lang Date) endOfDay sets the time to 23:59:59.999.")
	public dateEndOfDay() {
		d = new Date(); d.parse("2024-03-15 08:30:45", "yyyy-MM-dd HH:mm:ss");
		d.endOfDay();
		return test.expect(d.getHours() == 23 && d.getMinutes() == 59 && d.getSeconds() == 59 && d.getMilliseconds() == 999, true);
	}

