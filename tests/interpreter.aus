	@Test(name = "(util regex) Match all default.")
	public regexMatch() {
		res = regex.match("t.", this.testStr);
		return test.expect(res[1], "th");
	}

	@Test(name = "(util regex) Match first.")
	public regexMatchFirst() {
		res = regex.matchFirst("t.", this.testStr);
		return test.expect(res, 'ti');
	}

	@Test(name = "(util regex) Match last.")
	public regexMatchLast() {
		res = regex.matchLast("t.", this.testStr);
		return test.expect(res, 'to');
	}

	@Test(name = "(util regex) Regex replace.")
	public regexReplace() {
		res = regex.replace("t.", "th", this.testStr);
		return test.expect(res, "On a long enough thmeline, the survival rath for everyone drops th zero.");
	}

	@Test(name = "(util regex) Regex replace first.")
	public regexReplaceFirst() {
		res = regex.replaceFirst("t.", "th", this.testStr);
		return test.expect(res, "On a long enough thmeline, the survival rate for everyone drops to zero.");
	}

	/***********************************************************************
     * mock tests
     *********************************************************************/
    @Test(name = "(mock) Simple function mock test.")
    public simpleMockTest() {
        // Create a new user object.
        u = new user();
        u.firstName = "Austin";

        // Set the simple mock. (funName, retObj)
        u.mock("getName", "Avery");

        // Expect/Assert that the mocked function will return the value we provided.
        test.expect(u.getName(), "Avery");
    }

    @Test(name = "(mock) Mock when test 1.")
    public mockWhenTest1() {
        // Create a new user object.
        u = new user();
        u.firstName = "Tyler";
        u.lastName = "Durden";

        // Set the mock when. (funName, callback, retObj) When the result
        // of the callback is true, it will set to the provided value.
        u.mockWhen("getName", ::onMock1Test, "Bob Durden");
        test.expect(u.getName(), "Bob Durden");

        // Update the first name and then expect it to run without
        // matching the mock when. We should get the function to
        // run normally this time.
        u.firstName = "Fred";
        test.expect(u.getName(), "Fred Durden");
    }

    /**
     * What's provided here are two arguments. The first is the instance
     * of the object itself. The second is the arguments that were
     * provided to the invoking function.
     */
    public onMock1Test(cobj, args) {
        if (cobj.firstName == "Tyler") { return true; }
        return false;
    }

    @Test(name = "(mock) Mock when condition returning a string is a catchable error.")
    public mockWhenBadCondition() {
        u = new user();
        u.mockWhen("getName", ::onMockStringCond, "Bob Durden");
        ex = "";
        try { u.getName(); } catch (e) { ex = e.getText(); }
        return test.expect(ex, "mockWhen(): Condition expecting return type of bool, int or double but found cString instead.");
    }

    /** Condition for mockWhenBadCondition; returns the wrong type on purpose. */
    public onMockStringCond(cobj, args) { return "yes"; }

    @Test(name = "(mock) Spy set/get test 1.")
    public mockSpyTest1() {
        u = new user();
        u.setName("Tyler", "Durden");

        // Set the spy.
        u.setSpy("getName");

        // Call the function.
        name = u.getName();
        test.expect(#u.getSpy("getName"), 1);

        name = u.getName();
        test.expect(#u.getSpy("getName"), 2);
    }

    @Test(name = "(mock) Simple function mock test on string object.")
    public simpleStringMockTest() {
        // Create a new string object.
        name = "Tyler Durden";

        // Set the simple mock. (funName, retObj)
        name.mock("toLower", "TYLER DURDEN");

        // Expect/Assert that the mocked function will return the value we provided.
        test.expect(name.toLower(), "TYLER DURDEN");
    }

    /***********************************************************************
     * lexer comment tests
     *********************************************************************/

    // Banner-style block comments must be lexed as plain block comments,
    // not as AUSSOM_DOC. Otherwise a banner followed by a real doc comment
    // emits two AUSSOM_DOC tokens in a row and the parser rejects them.
    // Tests load source via testRunner.loadTestString which throws on
    // parse error; passing means the load succeeded.

    @Test(name = "(lexer comments) Banner divider then real doc comment then class.")
    public lexerBannerThenDocBeforeClass() {
        src = "/*****\n * Section divider\n *****/\n\n/**\n * Real doc comment\n */\nclass lcz { public main() { return 1; } }";
        ok = false;
        try {
            r = new testRunner();
            r.loadTestString("lc_banner_then_doc", src);
            ok = true;
        } catch (e) { ok = false; }
        return test.expect(ok, true);
    }

    @Test(name = "(lexer comments) Two banner dividers in a row before class.")
    public lexerTwoBannersBeforeClass() {
        src = "/*****\n * A\n *****/\n\n/*****\n * B\n *****/\nclass lcw { public main() { return 1; } }";
        ok = false;
        try {
            r = new testRunner();
            r.loadTestString("lc_two_banners", src);
            ok = true;
        } catch (e) { ok = false; }
        return test.expect(ok, true);
    }

    @Test(name = "(lexer comments) Inline four-star divider then real doc comment.")
    public lexerInlineDividerThenDoc() {
        src = "/****/\n\n/**\n * Real doc\n */\nclass lcv { public main() { return 1; } }";
        ok = false;
        try {
            r = new testRunner();
            r.loadTestString("lc_inline_divider", src);
            ok = true;
        } catch (e) { ok = false; }
        return test.expect(ok, true);
    }

    @Test(name = "(lexer comments) Long realistic banner then doc comment.")
    public lexerLongBannerThenDoc() {
        bar = "/******************************************************************\n";
        body = " * Section A: setup helpers\n";
        end = " ******************************************************************/\n";
        doc = "\n/**\n * Sets things up.\n */\n";
        cls = "class lcu { public main() { return 1; } }";
        src = bar + body + end + doc + cls;
        ok = false;
        try {
            r = new testRunner();
            r.loadTestString("lc_long_banner", src);
            ok = true;
        } catch (e) { ok = false; }
        return test.expect(ok, true);
    }

    /***********************************************************************
     * Method overloading by signature.
     *
     * Covers arity overloads, type-discrimination, numeric promotion
     * (int -> double), wildcards (full and partial), specificity,
     * ambiguity policy, variadic dispatch, default arguments, null
     * matching, multi-level inheritance, constructor overloading,
     * per-overload access modifiers, recursive self-calls through
     * overloaded names, mixed wildcard + variadic interaction, and
     * typed-variadic promotion.
     *
     * Negative tests use try/catch to capture exception text.
     * Helper classes are declared at the top of this file.
     *********************************************************************/

    // ---------- Arity overloading ----------

    @Test(name = "(arity) Zero-arg overload selected on no-arg call.")
    public arityZero() {
        s = new shape();
        return test.expect(s.draw(), "no-args");
    }

    @Test(name = "(arity) Two-arg overload selected on 2-arg call.")
    public arityTwo() {
        s = new shape();
        return test.expect(s.draw(1, 2), "two-ints");
    }

    @Test(name = "(arity) Three-arg overload selected on 3-arg call.")
    public arityThree() {
        s = new shape();
        return test.expect(s.draw(1, 2, 3), "three-ints");
    }

    @Test(name = "(arity) Wrong-arity call raises FUNCT_NOT_FOUND.")
    public arityNoMatch() {
        s = new shape();
        ex = "";
        try { s.draw(1, 2, 3, 4); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("no overload"), true);
    }

    // ---------- Type-based overloading ----------

    @Test(name = "(types) Int overload selected on int call.")
    public typesInt() {
        l = new location();
        return test.expect(l.set(1, 2), "int-int");
    }

    @Test(name = "(types) Double overload selected on double call.")
    public typesDouble() {
        l = new location();
        return test.expect(l.set(1.0, 2.0), "double-double");
    }

    @Test(name = "(types) String overload selected on string call.")
    public typesString() {
        l = new location();
        return test.expect(l.set("origin"), "string");
    }

    @Test(name = "(types) Single-int overload distinct from two-int.")
    public typesSingleInt() {
        l = new location();
        return test.expect(l.set(42), "int");
    }

    // ---------- Single-arg overload by type ----------

    @Test(name = "(single-arg) Int arg selects the int overload.")
    public singleArgInt() { return test.expect((new ovKind()).k(5), "int"); }

    @Test(name = "(single-arg) Double arg selects the double overload.")
    public singleArgDouble() { return test.expect((new ovKind()).k(2.5), "double"); }

    @Test(name = "(single-arg) Bool arg selects the bool overload.")
    public singleArgBool() { return test.expect((new ovKind()).k(true), "bool"); }

    @Test(name = "(single-arg) String arg selects the string overload.")
    public singleArgString() { return test.expect((new ovKind()).k("x"), "string"); }

    @Test(name = "(single-arg) Variadic coexists with a single typed overload.")
    public singleArgVariadicOne() { return test.expect((new ovVar()).v(5), "one"); }

    @Test(name = "(single-arg) Variadic catches the multi-arg call.")
    public singleArgVariadicMany() { return test.expect((new ovVar()).v(1, 2), "var"); }

    @Test(name = "(single-arg) Default single-arg overload uses default on no-arg call.")
    public singleArgDefaultNone() { return test.expect((new ovDef()).d(), 9); }

    @Test(name = "(single-arg) Default single-arg overload uses the provided value.")
    public singleArgDefaultGiven() { return test.expect((new ovDef()).d(3), 3); }

    // ---------- Single-arg overload coexistence across types ----------
    // Two reference-typed single-arg overloads (string/list/map/object/
    // callback) must be able to coexist on one method name; they are
    // distinguishable by a non-null argument. Built as source strings so
    // a parse error here can't break the whole test file.
    // coexistOk() returns true when the source loads without error.

    public coexistOk(string Name, string Body) {
        src = "class " + Name + " { " + Body + " }\n";
        ok = false;
        try { r = new testRunner(); r.loadTestString(Name, src); ok = true; } catch (e) { ok = false; }
        return ok;
    }

    @Test(name = "(single-arg coexist) string and list overloads coexist.")
    public coexistStringList() {
        return test.expect(this.coexistOk("ovSL", "public s(string X) { return 1; } public s(list X) { return 2; }"), true);
    }

    @Test(name = "(single-arg coexist) string and map overloads coexist.")
    public coexistStringMap() {
        return test.expect(this.coexistOk("ovSM", "public s(string X) { return 1; } public s(map X) { return 2; }"), true);
    }

    @Test(name = "(single-arg coexist) list and map overloads coexist.")
    public coexistListMap() {
        return test.expect(this.coexistOk("ovLM", "public s(list X) { return 1; } public s(map X) { return 2; }"), true);
    }

    @Test(name = "(single-arg coexist) string and object overloads coexist.")
    public coexistStringObject() {
        return test.expect(this.coexistOk("ovSO", "public s(string X) { return 1; } public s(object X) { return 2; }"), true);
    }

    @Test(name = "(single-arg coexist) list and callback overloads coexist.")
    public coexistListCallback() {
        return test.expect(this.coexistOk("ovLC", "public s(list X) { return 1; } public s(callback X) { return 2; }"), true);
    }

    @Test(name = "(single-arg coexist) reference overload with a default coexists with another.")
    public coexistRefDefaults() {
        return test.expect(this.coexistOk("ovRD", "public s(string X) { return 1; } public s(list X = []) { return 2; }"), true);
    }

    @Test(name = "(single-arg coexist) two defaulted single-arg overloads still conflict at zero-arg.")
    public coexistBothDefaultsConflict() {
        // Both accept a no-arg call via their defaults, so s() is a real
        // ambiguity regardless of type -- this must still be rejected.
        return test.expect(this.coexistOk("ovBD", "public s(string X = \"\") { return 1; } public s(list X = []) { return 2; }"), false);
    }

    @Test(name = "(single-arg coexist) three-way int, string, list coexist.")
    public coexistIntStringList() {
        return test.expect(this.coexistOk("ovISL", "public s(int X) { return 1; } public s(string X) { return 2; } public s(list X) { return 3; }"), true);
    }

    @Test(name = "(single-arg coexist) all single-arg types coexist.")
    public coexistAllTypes() {
        return test.expect(this.coexistOk("ovAll", "public s(int X) { return 1; } public s(double X) { return 2; } public s(bool X) { return 3; } public s(string X) { return 4; } public s(list X) { return 5; } public s(map X) { return 6; } public s(object X) { return 7; }"), true);
    }

    @Test(name = "(single-arg coexist) non-reference types coexist (control).")
    public coexistNonRef() {
        return test.expect(this.coexistOk("ovNR", "public s(int X) { return 1; } public s(double X) { return 2; } public s(bool X) { return 3; }"), true);
    }

    @Test(name = "(single-arg coexist) reference type coexists with variadic (control).")
    public coexistRefVariadic() {
        return test.expect(this.coexistOk("ovRV", "public s(string X) { return 1; } public s(...) { return 2; }"), true);
    }

    // ---------- Null argument against reference-typed overloads ----------

    @Test(name = "(single-arg null) Non-null args dispatch to their reference overload.")
    public nullArgTypedDispatch() {
        o = new ovNull();
        test.expect(o.s("x"), "string");
        return test.expect(o.s([1]), "list");
    }

    @Test(name = "(single-arg null) Null arg is ambiguous between reference overloads.")
    public nullArgAmbiguous() {
        o = new ovNull();
        ex = "";
        try { o.s(null); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("Ambiguous overload"), true);
    }

    @Test(name = "(single-arg null) Wildcard overload absorbs a null arg.")
    public nullArgWildcard() {
        o = new ovNullWild();
        test.expect(o.s("x"), "string");
        test.expect(o.s([1]), "list");
        return test.expect(o.s(null), "wild");
    }

    @Test(name = "(single-arg null) Single reference overload accepts null.")
    public nullArgSingleRef() {
        o = new ovNullOne();
        test.expect(o.s("x"), "string");
        return test.expect(o.s(null), "string");
    }

    @Test(name = "(single-arg null) Inherited reference overloads keep the null ambiguity.")
    public nullArgInherited() {
        o = new ovNullChild();
        test.expect(o.s("x"), "string");
        test.expect(o.s([1]), "list");
        ex = "";
        try { o.s(null); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("Ambiguous overload"), true);
    }

    // ---------- Numeric promotion (int -> double) ----------

    @Test(name = "(promotion) Int call promoted to double when no int overload exists.")
    public promotionIntToDouble() {
        p = new promoteOnly();
        return test.expect(p.f(7), "double:7.0");
    }

    @Test(name = "(promotion) Exact int overload beats promoted double.")
    public promotionExactBeats() {
        l = new location();
        return test.expect(l.set(1, 2), "int-int");
    }

    @Test(name = "(promotion) Mixed int/double call promotes int -> double.")
    public promotionMixed() {
        l = new location();
        // (int, double) - no exact overload; one promotion -> "double-double".
        return test.expect(l.set(1, 2.5), "double-double");
    }

    @Test(name = "(promotion) Equally-specific promoted matches raise AMBIGUOUS_OVERLOAD.")
    public promotionAmbiguity() {
        a = new promoteAmbig();
        ex = "";
        try { a.f(1, 2); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("ambiguous"), true);
    }

    @Test(name = "(promotion) Double argument does not narrow to int slot.")
    public promotionNoNarrow() {
        // location.set(int, int) and (double, double) exist; (1.5, 2)
        // should promote the int (2 -> 2.0) and resolve to double-double,
        // not narrow 1.5 to an int.
        l = new location();
        return test.expect(l.set(1.5, 2), "double-double");
    }

    @Test(name = "(promotion) All int args promote when only an all-double overload exists.")
    public promotionBothArgs() {
        pb = new promoteBoth();
        return test.expect(pb.f(3, 4), 7.0);
    }

