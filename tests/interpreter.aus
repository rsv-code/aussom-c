	  * object operations tests
	  *********************************************************************/
	 @Test(name = "(object operations) Instantiate local object.")
	 public objectInstantiateLocal() { me = new user(); me.setName("Tyler", "Durden"); return test.expect(me.getName(), "Tyler Durden"); }

	 @Test(name = "(object operations) Instantiate member object.")
	 public objectInstantiateMember() { this.memObj = new user(); this.memObj.setName("Tyler", "Durden"); return test.expect(this.memObj.getName(), "Tyler Durden"); }

	 @Test(name = "(object operations) Local object set member.")
	 public objectLocalSetMember() { me = new user(); me.firstName = "Tyler"; return test.expect(me.getName(), "Tyler "); }

	 @Test(name = "(object operations) Member object set member.")
	 public objectMemberSetMember() { this.memObj.firstName = "Austin"; return test.expect(this.memObj.getName(), "Austin Durden"); }

	 @Test(name = "(object operations) Local object set sub member.")
	 public objectLocalSetSubMember() { me = new user(); me.emailAddress.address = "one@two.com"; return test.expect(me.emailAddress.address, "one@two.com"); }

	 @Test(name = "(object operations) Member object set sub member.")
	 public objectMemberSetSubMember() { this.memObj.emailAddress.address = "one@two.com"; return test.expect(this.memObj.emailAddress.address, "one@two.com"); }

	 @Test(name = "(object operations) Local object call sub member.")
	 public objectLocalCallSubMember() { me = new user(); me.emailAddress.setAddress("one@two.com"); return test.expect(me.emailAddress.getAddress(), "one@two.com"); }

	 @Test(name = "(object operations) Member object call sub member.")
	 public objectMemberCallSubMember() { this.memObj.emailAddress.setAddress("one@two.com"); return test.expect(this.memObj.emailAddress.getAddress(), "one@two.com"); }

	 @Test(name = "(object operations) Local object set block.")
	 public objectLocalSetBlock() {
	    me = new user() := {
	        firstName: "Tyler",
	        lastName: "Durden"
	    };
	    return test.expect(me.firstName, "Tyler");
	 }

	 @Test(name = "(object operations) Member object set block.")
	 public objectMemberSetBlock() {
	    this.memObj = new user() := {
	        firstName: "Tyler",
	        lastName: "Durden"
	    };
	    return test.expect(this.memObj.firstName, "Tyler");
	 }

	 @Test(name = "(object operations) Local object set block function.")
	 public objectLocalSetBlockFunction() {
	    cr = new car() := {
	        make: "Nissan"
	    };
	    return test.expect(cr.getMake(), "Nissan");
	 }

	 @Test(name = "(object operations) Member object set block function.")
	 public objectMemberSetBlockFunction() {
	    this.cr = new car() := {
	        make: "Nissan"
	    };
	    return test.expect(this.cr.getMake(), "Nissan");
	 }

	 @Test(name = "(object operations) Local object set block as variable.")
	 public objectLocalSetBlockAsVariable() {
	    mpVal = {
	        make: "Nissan"
	    };
	    cr = new car() := mpVal;
	    return test.expect(cr.getMake(), "Nissan");
	 }

	 @Test(name = "(object operations) Member object set block as variable.")
	 public objectMemberSetBlockAsVariable() {
	    mpVal = {
	        make: "Nissan"
	    };
	    this.cr = new car() := mpVal;
	    return test.expect(this.cr.getMake(), "Nissan");
	 }

	 @Test(name = "(object operations) Local object set block exception.")
	 public objectLocalSetBlockException() {
	    try {
            me = new user() := [
                "Robert"
            ];
            return false;
        } catch (e) {
            return true;
        }
	 }

	 @Test(name = "(object operations) Constructor exception caught by surrounding try/catch.")
	 public objectConstructorExceptionCaught() {
	    thrown = false;
	    try {
	        // The Date(int Mills) constructor delegates to an extern call
	        // that fails when given a non-int. The thrown exception must
	        // be caught by this surrounding try/catch.
	        d = new Date("not_a_date");
	    } catch (e) {
	        thrown = true;
	    }
	    return test.expect(thrown, true);
	 }

	 @Test(name = "(object operations) Constructor argument expression exception caught by surrounding try/catch.")
	 public objectConstructorArgExceptionCaught() {
	    thrown = false;
	    try {
	        // An expression evaluated for a 'new' argument throws.
	        // The exception must be catchable by the surrounding try/catch.
	        n = new needsArg(throwingHelper.boom());
	    } catch (e) {
	        thrown = true;
	    }
	    return test.expect(thrown, true);
	 }

	 @Test(name = "(object operations) Instantiating an unknown class caught by surrounding try/catch.")
	 public objectInstantiateUnknownClassCaught() {
	    thrown = false;
	    try {
	        // No class named 'thisClassDoesNotExist' exists. The instantiation
	        // failure must be catchable by the surrounding try/catch.
	        x = new thisClassDoesNotExist();
	    } catch (e) {
	        thrown = true;
	    }
	    return test.expect(thrown, true);
	 }

	 @Test(name = "(object operations) Inheriting from a missing base class caught by surrounding try/catch.")
	 public objectInheritMissingBaseCaught() {
	    thrown = false;
	    try {
	        // childOfMissing extends a base class that does not exist.
	        // The class-init error must be catchable by the surrounding try/catch.
	        x = new childOfMissing();
	    } catch (e) {
	        thrown = true;
	    }
	    return test.expect(thrown, true);
	 }

	 @Test(name = "(object operations) reflect.instantiate runs default-parameter constructor.")
	 public reflectInstantiateDefaultParam() {
	    o = reflect.instantiate("reflectInstWithDefault");
	    return test.expect(o.n, 7);
	 }

	 @Test(name = "(object operations) reflect.instantiate constructor body reads local correctly.")
	 public reflectInstantiateReadsLocalInCtor() {
	    o = reflect.instantiate("reflectInstReadsLocal");
	    return test.expect(o.n, 42);
	 }

	 // access public/private
	 @Test(name = "(object access) Member access for local variable public.")
	 public objectAccessLocVarPub() { l = new atest(); ex = false; try { t = l.pub; } catch(e) { ex = true; } return test.expect(ex, false); }

	 @Test(name = "(object access) Member access for local variable private.")
	 public objectAccessLocVarPri() { l = new atest(); ex = false; try { t = l.pri; } catch(e) { ex = true; } return test.expect(ex, true); }

	 @Test(name = "(object access) Method access for local variable public.")
