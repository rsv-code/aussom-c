	@Test(name = "(lang double) Double min value.")
	public doubleMinValue() { return test.expectDouble(Double.minVal()); }

	@Test(name = "(lang double) Double min normal value.")
	public doubleMinNormalValue() { return test.expectDouble(Double.minNormal()); }

	@Test(name = "(lang double) Double NaN value.")
	public doubleNaNValue() { return test.expectDouble(Double.nanVal()); }

	@Test(name = "(lang double) Double negative infinity value.")
	public doubleNegInfinity() { return test.expect(Double.negInfinity() + '', '-Infinity'); }

	@Test(name = "(lang double) Double positive infinity value.")
	public doublePosInfinity() { return test.expect(Double.posInfinity() + '', 'Infinity'); }

	@Test(name = "(lang double) Double size value.")
	public doubleSize() { return test.expect(Double.size(), 64.0); }

	@Test(name = "(lang double) Double to int.")
	public doubleToInt() { return test.expect((3.1415).toInt(), 3); }

	@Test(name = "(lang double) Double to bool.")
