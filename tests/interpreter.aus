	@Test(name = "(lang bool) Bool parse.")
	public boolParse() { return test.expect(Bool.parse('true'), true); }

	@Test(name = "(lang bool) bool.parse sets the value and returns this object.")
	public boolParseSetsValue() {
		b = true;
		r = b.parse('false');
		test.expect(r, false);
		return test.expect(b.pack(), '{"type":"bool","value":false}');
	}

	@Test(name = "(lang bool) Bool to JSON.")
	public boolToJson() { return test.expect((true).toJson(), 'true'); }
	
