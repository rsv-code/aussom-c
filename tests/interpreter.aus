        ex = "";
        try { r = new testRunner(); r.loadTestString("defExtern", src); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("must be public"), true);
    }

    // ---------- Recursive self-call into overloaded method ----------

    @Test(name = "(recursive) Self-call through an overloaded name dispatches identically.")
    public recursiveSelfCall() {
        r = new recursiveOverload();
        return test.expect(r.f(2), "n:n:base");
    }

    // ---------- Wildcard + variadic mixed on same name ----------

    @Test(name = "(mixed) Wildcard wins over variadic when arity matches.")
    public mixedWildcardWins() {
        m = new mixWildVar();
        return test.expect(m.f(1, "x"), "wild:1/x");
    }

    @Test(name = "(mixed) Variadic catches arity below wildcard's range.")
    public mixedVariadicLow() {
        m = new mixWildVar();
        return test.expect(m.f(1), "var:1/0");
    }

    @Test(name = "(mixed) Variadic catches arity above wildcard's range.")
    public mixedVariadicHigh() {
        m = new mixWildVar();
        return test.expect(m.f(1, 2, 3), "var:1/2");
    }

    // ---------- End-to-end multi-overload dispatch ----------

    @Test(name = "(end-to-end) Multiple overloads on one name dispatch by tag.")
    public endToEndDispatch() {
        l = new location();
        return test.expect(
            l.set(1, 2) + "/" + l.set(1.0, 2.0) + "/" + l.set("z") + "/" + l.set(5),
            "int-int/double-double/string/int");
    }
}

/***************************************************************************
 * aunit per-test hooks (@BeforeEach, @AfterEach, @OnTestFail), tag
 * filter (@Test tags="..."), and per-test timeout storage. Lives in its
 * own test class so the hooks and filters under test do not interfere
 * with the surrounding interpreterTests run.
 *
 * Each test loads a tiny helper class via testRunner.loadTestString and
 * either introspects the parsed UnitTest fields or drives the helper
 * class through the full per-test loop with runClassTests. That keeps
 * deliberate failures and hook errors contained inside the inner runner
 * so they cannot pollute this suite's pass/fail counts.
 ***************************************************************************/
@Test(name = "aunit hooks, tags, and timeout")
class aunitHookFilterTests {

    @Before
    public toRunBefore() {
        c.info("Ran unit test @Before function 'toRunBefore()'.");
    }

    @After
    public toRunAfter() {
        c.info("Ran unit test @After function 'toRunAfter()'.");
    }

    /***********************************************************************
     * Per-test hook annotation detection.
     *********************************************************************/

    @Test(name = "(per-test hooks) BeforeEach annotation is detected on parse.")
    public beforeEachAnnotationDetected() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"hookSrc\")\n";
        src = src + "class hookSrcB {\n";
        src = src + "  @BeforeEach public be() { return 0; }\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("hookSrcB", src);
        return test.expect(r.hasBeforeEach("hookSrcB"), true);
    }

    @Test(name = "(per-test hooks) AfterEach annotation is detected on parse.")
    public afterEachAnnotationDetected() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"hookSrc\")\n";
        src = src + "class hookSrcC {\n";
        src = src + "  @AfterEach public ae() { return 0; }\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("hookSrcC", src);
        return test.expect(r.hasAfterEach("hookSrcC"), true);
    }

    @Test(name = "(per-test hooks) OnTestFail annotation is detected on parse.")
    public onTestFailAnnotationDetected() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"hookSrc\")\n";
        src = src + "class hookSrcA {\n";
        src = src + "  @OnTestFail public oh() { return 0; }\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("hookSrcA", src);
        return test.expect(r.hasOnTestFail("hookSrcA"), true);
    }

    @Test(name = "(per-test hooks) Class without per-test hooks reports them as absent.")
    public hooksAbsentByDefault() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"plain\")\n";
        src = src + "class plainSrc {\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("plainSrc", src);
        if (r.hasBeforeEach("plainSrc") != false) { return test.fail("hasBeforeEach should be false"); }
        if (r.hasAfterEach("plainSrc") != false) { return test.fail("hasAfterEach should be false"); }
        if (r.hasOnTestFail("plainSrc") != false) { return test.fail("hasOnTestFail should be false"); }
        return true;
    }

    /***********************************************************************
     * Per-test hook execution. runClassTests drives a loaded class
     * through the full per-test loop. The result map carries
     * total/skipped/passed/failed counts.
     *********************************************************************/

    @Test(name = "(per-test hooks) OnTestFail fires on failing test, not on passing test.")
    public onTestFailFires() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"hookExec\")\n";
        src = src + "class hookExecA {\n";
        src = src + "  public failCount = 0;\n";
        src = src + "  public passCount = 0;\n";
        src = src + "  @OnTestFail public oh() { this.failCount = this.failCount + 1; }\n";
        src = src + "  @AfterEach public ae() { this.passCount = this.passCount + 1; }\n";
        src = src + "  @Test(name = \"good\") public good() { return test.expect(1, 1); }\n";
        src = src + "  @Test(name = \"bad\") public bad() { return test.expect(1, 2); }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("hookExecA", src);
        res = r.runClassTests("hookExecA");
        if (res["passed"] != 1) { return test.fail("expected 1 passed, got " + res["passed"]); }
        if (res["failed"] != 1) { return test.fail("expected 1 failed, got " + res["failed"]); }
        return true;
    }

    @Test(name = "(per-test hooks) BeforeEach throwing fails the test.")
    public beforeEachThrowFails() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"hookExec\")\n";
        src = src + "class hookExecB {\n";
        src = src + "  @BeforeEach public be() { throw \"boom\"; }\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("hookExecB", src);
        res = r.runClassTests("hookExecB");
        return test.expect(res["failed"], 1);
    }

    @Test(name = "(per-test hooks) AfterEach throwing does not flip a passed test.")
    public afterEachThrowDoesNotFail() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"hookExec\")\n";
        src = src + "class hookExecC {\n";
        src = src + "  @AfterEach public ae() { throw \"after-each-boom\"; }\n";
        src = src + "  @Test(name = \"t\") public t() { return test.expect(1, 1); }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("hookExecC", src);
        res = r.runClassTests("hookExecC");
        return test.expect(res["passed"], 1);
    }

    /***********************************************************************
     * Tag parsing.
     *********************************************************************/

    @Test(name = "(test tags) Comma-separated tags parse into a list.")
    public tagsParseList() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"tagSrc\")\n";
        src = src + "class tagSrcA {\n";
        src = src + "  @Test(name = \"t\", tags = \"slow,db\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("tagSrcA", src);
        tags = r.getTestTags("tagSrcA", "t");
        if (#tags != 2) { return test.fail("expected 2 tags, got " + #tags); }
        if (!tags.contains("slow")) { return test.fail("missing 'slow'"); }
        if (!tags.contains("db")) { return test.fail("missing 'db'"); }
        return true;
    }

    @Test(name = "(test tags) Whitespace around tags is trimmed.")
    public tagsTrimmed() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"tagSrc\")\n";
        src = src + "class tagSrcB {\n";
        src = src + "  @Test(name = \"t\", tags = \"  slow  ,  db  \") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("tagSrcB", src);
        tags = r.getTestTags("tagSrcB", "t");
        if (!tags.contains("slow")) { return test.fail("missing trimmed 'slow'"); }
        if (!tags.contains("db")) { return test.fail("missing trimmed 'db'"); }
        return true;
    }

    @Test(name = "(test tags) Missing tags arg yields empty list.")
    public tagsMissingEmpty() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"tagSrc\")\n";
        src = src + "class tagSrcC {\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("tagSrcC", src);
        return test.expect(#r.getTestTags("tagSrcC", "t"), 0);
    }

    /***********************************************************************
     * Tag include/exclude filter via shouldRun().
     *********************************************************************/

    // Helper: a runner with one test tagged "slow".
    public _mkTaggedRunner() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"filt\")\n";
        src = src + "class filtSrc {\n";
        src = src + "  @Test(name = \"t\", tags = \"slow\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("filtSrc", src);
        return r;
    }

    @Test(name = "(test tags) No filter -> tagged test runs.")
    public filterNone() {
        r = this._mkTaggedRunner();
        return test.expect(r.shouldRun("filtSrc", "t"), true);
    }

    @Test(name = "(test tags) Include matching tag -> runs.")
    public filterIncludeMatch() {
        r = this._mkTaggedRunner();
        r.setIncludeTags(["slow"]);
        return test.expect(r.shouldRun("filtSrc", "t"), true);
    }

    @Test(name = "(test tags) Include non-matching tag -> skipped.")
    public filterIncludeNoMatch() {
        r = this._mkTaggedRunner();
        r.setIncludeTags(["fast"]);
        return test.expect(r.shouldRun("filtSrc", "t"), false);
    }

    @Test(name = "(test tags) Exclude matching tag -> skipped.")
    public filterExcludeMatch() {
        r = this._mkTaggedRunner();
        r.setExcludeTags(["slow"]);
        return test.expect(r.shouldRun("filtSrc", "t"), false);
    }

    @Test(name = "(test tags) Exclude wins over include when both match.")
    public filterExcludeWins() {
        r = this._mkTaggedRunner();
        r.setIncludeTags(["slow"]);
        r.setExcludeTags(["slow"]);
        return test.expect(r.shouldRun("filtSrc", "t"), false);
    }

    @Test(name = "(test tags) Untagged test is skipped under any include filter.")
    public filterUntaggedExcludedByInclude() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"untag\")\n";
        src = src + "class untagSrc {\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("untagSrc", src);
        r.setIncludeTags(["fast"]);
        return test.expect(r.shouldRun("untagSrc", "t"), false);
    }

    @Test(name = "(test tags) Untagged test is unaffected by exclude filter.")
    public filterUntaggedUnaffectedByExclude() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"untag2\")\n";
        src = src + "class untag2Src {\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("untag2Src", src);
        r.setExcludeTags(["slow"]);
        return test.expect(r.shouldRun("untag2Src", "t"), true);
    }

    @Test(name = "(test tags) Tag filter excludes via runClassTests.")
    public tagFilterAtRuntime() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"runFilt\")\n";
        src = src + "class runFiltSrc {\n";
        src = src + "  @Test(name = \"fast\", tags = \"fast\") public f() { return 0; }\n";
        src = src + "  @Test(name = \"slow\", tags = \"slow\") public s() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("runFiltSrc", src);
        r.setExcludeTags(["slow"]);
        res = r.runClassTests("runFiltSrc");
        if (res["passed"] != 1) { return test.fail("expected 1 passed, got " + res["passed"]); }
        if (res["skipped"] != 1) { return test.fail("expected 1 skipped, got " + res["skipped"]); }
        return true;
    }

    /***********************************************************************
     * timeoutMs parsing. The base runner does not enforce the value;
     * these tests only verify that the annotation is captured and
     * exposed for a downstream watchdog.
     *********************************************************************/

    @Test(name = "(test timeout) Numeric string parses to long.")
    public timeoutParsesLong() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"toSrc\")\n";
        src = src + "class toSrcA {\n";
        src = src + "  @Test(name = \"t\", timeoutMs = \"2000\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("toSrcA", src);
        return test.expect(r.getTestTimeoutMs("toSrcA", "t"), 2000);
    }

    @Test(name = "(test timeout) Missing arg yields 0.")
    public timeoutMissingZero() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"toSrc\")\n";
        src = src + "class toSrcB {\n";
        src = src + "  @Test(name = \"t\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("toSrcB", src);
        return test.expect(r.getTestTimeoutMs("toSrcB", "t"), 0);
    }

    @Test(name = "(test timeout) Unparseable string yields 0.")
    public timeoutUnparseableZero() {
        src = "include aunit;\n";
        src = src + "@Test(name = \"toSrc\")\n";
        src = src + "class toSrcC {\n";
        src = src + "  @Test(name = \"t\", timeoutMs = \"not-a-number\") public t() { return 0; }\n";
        src = src + "}\n";
        r = new testRunner();
        r.loadTestString("toSrcC", src);
        return test.expect(r.getTestTimeoutMs("toSrcC", "t"), 0);
    }
}

// Helpers for the indexed list/map assignment tests.
class assignPoint {
    public x = 0;
    public y = 0;
    public assignPoint(int X, int Y) { this.x = X; this.y = Y; }
}

class assignContainer {
    public lst = [];
    public mp = {};
    public p = null;
    public x = 0;
    public assignContainer() {
        this.lst = [10, 20, 30];
        this.mp = {"a": 1, "b": 2};
        this.p = new assignPoint(0, 0);
        this.x = 5;
    }
}

/***************************************************************************
 * Indexed list/map assignment matrix.
 *
 * Covers the full compound-lvalue surface: list-rooted, map-rooted, and
 * object-member-rooted chains, including 2- and 3-level nesting, mixed
 * list/map/object intermediates, terminal vs chained writes, compound
 * op-assigns (+=) and increments (++), variable-key writes, and
 * regression guards on the cases that already worked before the fix.
 *
 * Pre-fix:
 *   - Terminal list-slot writes threw ASSIGN_NOT_POSSIBLE.
 *   - Any chain that descended through a map intermediate silently
 *     overwrote the outer map slot instead of the inner key (the
 *     throw users sometimes saw fired on the next read of the
 *     corrupted state, not on the assignment itself).
 ***************************************************************************/
@Test(name = "indexed list/map assignment")
class indexedAssignTests {

    @Before
    public toRunBefore() {
        c.info("Ran unit test @Before function 'toRunBefore()'.");
    }

    @After
    public toRunAfter() {
        c.info("Ran unit test @After function 'toRunAfter()'.");
    }

    /* --- List-rooted --- */

    @Test(name = "(idx assign) Terminal list slot.")
    public listIdxTerminal() {
        lst = ["a","b","c"]; lst[0] = "x";
        return test.expect(lst[0], "x");
    }

    @Test(name = "(idx assign) Terminal list slot preserves siblings.")
    public listIdxPreserves() {
        lst = ["a","b","c"]; lst[1] = "y";
        return test.expect(lst[0] + lst[1] + lst[2], "ayc");
    }

    @Test(name = "(idx assign) Terminal list slot with variable index.")
    public listIdxVarIndex() {
        lst = [10,20,30]; i = 2; lst[i] = 99;
        return test.expect(lst[2], 99);
    }

    @Test(name = "(idx assign) List out-of-bounds write throws.")
    public listIdxOob() {
        lst = ["a"]; threw = false;
        try { lst[5] = "z"; } catch (e) { threw = true; }
        return test.expect(threw, true);
    }

    @Test(name = "(idx assign) Nested list slot.")
    public listOfList() {
        lst = [[1,2,3],[4,5,6]]; lst[0][1] = 99;
        return test.expect(lst[0][1], 99);
    }

    @Test(name = "(idx assign) List of map terminal key still works.")
    public listOfMap() {
        lst = [{"k": 1}, {"k": 2}]; lst[0]["k"] = 99;
        return test.expect(lst[0]["k"], 99);
    }

    @Test(name = "(idx assign) List of object terminal member still works.")
    public listOfObj() {
        lst = [new assignPoint(1,2), new assignPoint(3,4)]; lst[0].x = 99;
        return test.expect(lst[0].x, 99);
    }

    @Test(name = "(idx assign) Three-level nested list.")
    public threeLevelList() {
        lst = [[[1]]]; lst[0][0][0] = 99;
        return test.expect(lst[0][0][0], 99);
    }

    @Test(name = "(idx assign) List of map of map, deep key.")
    public listMapMap() {
        lst = [{"a": {"b": 1}}]; lst[0]["a"]["b"] = 99;
        return test.expect(lst[0]["a"]["b"], 99);
    }

    @Test(name = "(idx assign) List of map of list, inner index.")
    public listMapList() {
        lst = [{"a": [1,2,3]}]; lst[0]["a"][1] = 99;
        return test.expect(lst[0]["a"][1], 99);
    }

    @Test(name = "(idx assign) += on list slot.")
    public listSlotPlusEq() {
        lst = [10,20,30]; lst[1] += 5;
        return test.expect(lst[1], 25);
    }

    @Test(name = "(idx assign) ++ on list slot.")
    public listSlotPlusPlus() {
        lst = [10,20,30]; lst[1]++;
        return test.expect(lst[1], 21);
    }

    /* --- Map-rooted --- */

    @Test(name = "(idx assign) Terminal map key still works.")
    public mapTerminal() {
        mp = {"a": 1}; mp["a"] = 99;
        return test.expect(mp["a"], 99);
    }

    @Test(name = "(idx assign) Variable-key terminal map write.")
    public mapVarKey() {
        mp = {}; k = "name"; mp[k] = 99;
        return test.expect(mp[k], 99);
    }

    @Test(name = "(idx assign) += on terminal map slot still works.")
    public mapTerminalPlusEq() {
        mp = {"a": 10}; mp["a"] += 5;
        return test.expect(mp["a"], 15);
    }

    @Test(name = "(idx assign) ++ on terminal map slot still works.")
    public mapTerminalPlusPlus() {
        mp = {"a": 10}; mp["a"]++;
        return test.expect(mp["a"], 11);
    }

    @Test(name = "(idx assign) Map of map, nested key.")
    public mapOfMap() {
        mp = {"a": {"b": 1}}; mp["a"]["b"] = 99;
        return test.expect(mp["a"]["b"], 99);
    }

    @Test(name = "(idx assign) Map of map preserves inner type.")
    public mapOfMapPreservesType() {
        mp = {"a": {"b": 1, "c": 2}}; mp["a"]["b"] = 99;
        return test.expect(mp["a"]["c"], 2);
    }

    @Test(name = "(idx assign) Three-level map.")
    public threeLevelMap() {
        mp = {"a": {"b": {"c": 1}}}; mp["a"]["b"]["c"] = 99;
        return test.expect(mp["a"]["b"]["c"], 99);
    }

    @Test(name = "(idx assign) Map of list, inner index.")
    public mapOfList() {
        mp = {"a": [1,2,3]}; mp["a"][1] = 99;
        return test.expect(mp["a"][1], 99);
    }

    @Test(name = "(idx assign) Map of list preserves siblings.")
    public mapOfListPreservesSiblings() {
        mp = {"a": [10,20,30]}; mp["a"][1] = 99;
        return test.expect(mp["a"][0] + "," + mp["a"][2], "10,30");
    }

    @Test(name = "(idx assign) Map of object, member.")
    public mapOfObj() {
        mp = {"a": new assignPoint(1,2)}; mp["a"].x = 99;
        return test.expect(mp["a"].x, 99);
    }

    @Test(name = "(idx assign) += on nested map keys.")
    public mapNestedPlusEq() {
        mp = {"a": {"b": 10}}; mp["a"]["b"] += 5;
        return test.expect(mp["a"]["b"], 15);
    }

    @Test(name = "(idx assign) += on map of list inner index.")
    public mapListPlusEq() {
        mp = {"a": [10,20]}; mp["a"][0] += 5;
        return test.expect(mp["a"][0], 15);
    }

    @Test(name = "(idx assign) Map of object, chained member.")
    public mapObjMember() {
        o = new assignContainer();
        mp = {"a": o};
        mp["a"].p.x = 99;
        return test.expect(mp["a"].p.x, 99);
    }

    @Test(name = "(idx assign) Map of object, member list slot.")
    public mapObjMemberList() {
        o = new assignContainer();
        mp = {"a": o};
        mp["a"].lst[0] = 99;
        return test.expect(mp["a"].lst[0], 99);
    }

    @Test(name = "(idx assign) Map of object, member map key.")
    public mapObjMemberMap() {
        o = new assignContainer();
        mp = {"a": o};
        mp["a"].mp["a"] = 99;
        return test.expect(mp["a"].mp["a"], 99);
    }

    @Test(name = "(idx assign) Missing intermediate map key throws.")
    public missingIntermediate() {
        mp = {}; threw = false;
        try { mp["a"]["b"] = 99; } catch (e) { threw = true; }
        return test.expect(threw, true);
    }

    @Test(name = "(idx assign) Missing intermediate leaves outer map empty.")
    public missingIntermediateNoCorrupt() {
        mp = {};
        try { mp["a"]["b"] = 99; } catch (e) { }
        return test.expect(#mp.keySet(), 0);
    }

    /* --- Object-member-rooted --- */

    @Test(name = "(idx assign) Terminal object member still works.")
    public objTerminalMember() {
        o = new assignContainer(); o.x = 99;
        return test.expect(o.x, 99);
    }

    @Test(name = "(idx assign) += on object member.")
    public objMemberPlusEq() {
        o = new assignContainer(); o.x += 1;
        return test.expect(o.x, 6);
    }

    @Test(name = "(idx assign) ++ on object member.")
    public objMemberPlusPlus() {
        o = new assignContainer(); o.x++;
        return test.expect(o.x, 6);
    }

    @Test(name = "(idx assign) Chained members still work.")
    public chainedMembers() {
        o = new assignContainer(); o.p.x = 99;
        return test.expect(o.p.x, 99);
    }

    @Test(name = "(idx assign) Member map terminal key still works.")
    public memberMapTerminal() {
        o = new assignContainer(); o.mp["a"] = 99;
        return test.expect(o.mp["a"], 99);
    }

    @Test(name = "(idx assign) += on member map terminal slot.")
    public memberMapTerminalPlusEq() {
        o = new assignContainer(); o.mp["a"] += 5;
        return test.expect(o.mp["a"], 6);
    }

    @Test(name = "(idx assign) Member list terminal slot.")
    public memberListTerminal() {
        o = new assignContainer(); o.lst[0] = 99;
        return test.expect(o.lst[0], 99);
    }

    @Test(name = "(idx assign) Member list-of-list, inner slot.")
    public memberListOfList() {
        o = new assignContainer();
        o.lst = [[1,2],[3,4]]; o.lst[0][1] = 99;
        return test.expect(o.lst[0][1], 99);
    }

    @Test(name = "(idx assign) Member list of map terminal key still works.")
    public memberListOfMap() {
        o = new assignContainer();
        o.lst = [{"k": 1}]; o.lst[0]["k"] = 99;
        return test.expect(o.lst[0]["k"], 99);
    }

    @Test(name = "(idx assign) Member list of object terminal member still works.")
    public memberListOfObj() {
        o = new assignContainer();
        o.lst = [new assignPoint(1,2)]; o.lst[0].x = 99;
        return test.expect(o.lst[0].x, 99);
    }

    @Test(name = "(idx assign) Member map of map, nested key.")
    public memberMapOfMap() {
        o = new assignContainer();
        o.mp = {"a": {"b": 1}}; o.mp["a"]["b"] = 99;
        return test.expect(o.mp["a"]["b"], 99);
    }

    @Test(name = "(idx assign) Member map of list, inner index.")
    public memberMapOfList() {
        o = new assignContainer();
        o.mp = {"a": [1,2,3]}; o.mp["a"][1] = 99;
        return test.expect(o.mp["a"][1], 99);
    }

    @Test(name = "(idx assign) Member map of object, member.")
    public memberMapOfObj() {
        o = new assignContainer();
        o.mp = {"a": new assignPoint(1,2)}; o.mp["a"].x = 99;
        return test.expect(o.mp["a"].x, 99);
    }
}

/***************************************************************************
 * concurrent.aus module.
 *
 * API coverage for the concurrency primitives: AtomicLong, AtomicBool,
 * AtomicRef, Counter, BlockingQueue, Semaphore, Latch, and Lock. These
 * are single-threaded API tests. The cross-thread exactness stress
 * tests (exact counts under 8-thread contention) live in
 * src/test/java/ConcurrencyRegressionTest.java because aussom-base has
 * no script-level threads to drive them with.
 ***************************************************************************/
@Test(name = "concurrent module")
class concurrentTests {
    private lk = null;
    private q = null;

    @Test(name = "(concurrent) AtomicLong basics and chaining")
    public atomicLongBasics() {
        a = new AtomicLong(5);
        test.expect(a.get(), 5);
        test.expect(a.incrementAndGet(), 6);
        test.expect(a.decrementAndGet(), 5);
        test.expect(a.addAndGet(10), 15);
        return test.expect(a.set(42).get(), 42);
    }

    @Test(name = "(concurrent) AtomicLong getAndSet and compareAndSet")
    public atomicLongCas() {
        a = new AtomicLong(15);
        test.expect(a.getAndSet(2), 15);
        test.expectTrue(a.compareAndSet(2, 7));
        test.expectFalse(a.compareAndSet(2, 9));
        return test.expect(a.get(), 7);
    }

    @Test(name = "(concurrent) AtomicBool one-shot guard")
    public atomicBoolGuard() {
        b = new AtomicBool();
        test.expectFalse(b.get());
        test.expectTrue(b.compareAndSet(false, true));
        test.expectFalse(b.compareAndSet(false, true));
        test.expectTrue(b.getAndSet(false));
        return test.expectFalse(b.get());
    }

    @Test(name = "(concurrent) AtomicRef identity compareAndSet")
    public atomicRefCas() {
        a = [1, 2, 3];
        ref = new AtomicRef(a);
        b = [9];
        // Same instance: swap happens. Second try: current is b now.
        test.expectTrue(ref.compareAndSet(a, b));
        test.expectFalse(ref.compareAndSet(a, b));
        return test.expect(#ref.get(), 1);
    }

    @Test(name = "(concurrent) AtomicRef null matches null and getAndSet")
    public atomicRefNull() {
        ref = new AtomicRef();
        test.expectNull(ref.get());
        test.expectTrue(ref.compareAndSet(null, "x"));
        test.expect(ref.get(), "x");
        test.expect(ref.getAndSet("y"), "x");
        return test.expect(ref.get(), "y");
    }

    @Test(name = "(concurrent) Counter sum and reset")
    public counterSum() {
        cnt = new Counter();
        cnt.increment().increment().add(10).decrement();
        test.expect(cnt.sum(), 11);
        cnt.reset();
        return test.expect(cnt.sum(), 0);
    }

    @Test(name = "(concurrent) BlockingQueue FIFO order, size, clear")
    public queueFifo() {
        bq = new BlockingQueue();
        test.expectTrue(bq.offer("a"));
        bq.offer("b");
        test.expect(bq.size(), 2);
        test.expect(bq.poll(), "a");
        test.expect(bq.poll(), "b");
        test.expectNull(bq.poll());
        bq.offer(1);
        bq.clear();
        return test.expect(bq.size(), 0);
    }

    @Test(name = "(concurrent) BlockingQueue bounded rejects when full")
    public queueBounded() {
        bq = new BlockingQueue(1);
        test.expectTrue(bq.offer("a"));
        return test.expectFalse(bq.offer("b"));
    }

    @Test(name = "(concurrent) BlockingQueue rejects null values")
    public queueNull() {
        this.q = new BlockingQueue();
        return test.expectThrows(::offerNull);
    }

    /** Callback for queueNull; offering null must throw. */
    public offerNull() {
        this.q.offer(null);
    }

    @Test(name = "(concurrent) Semaphore permits, timeout, release")
    public semaphorePermits() {
        s = new Semaphore(2);
        test.expectTrue(s.tryAcquire());
        test.expectTrue(s.tryAcquire());
        test.expectFalse(s.tryAcquire());
        test.expectFalse(s.tryAcquire(50));
        s.release();
        test.expect(s.availablePermits(), 1);
        return test.expectTrue(s.tryAcquire());
    }

    @Test(name = "(concurrent) Latch countdown and await timeout")
    public latchCountdown() {
        l = new Latch(2);
        test.expect(l.getCount(), 2);
        test.expectFalse(l.await(50));
        l.countDown().countDown();
        test.expect(l.getCount(), 0);
        return test.expectTrue(l.await(50));
    }

    @Test(name = "(concurrent) Lock.withLock runs, returns, reenters, releases")
    public lockWithLock() {
        this.lk = new Lock();
        test.expect(this.lk.withLock(::lockSimple), 41);
        // Reentrant: the outer callback takes the same lock again.
        test.expect(this.lk.withLock(::lockOuter), "nested");
        // Released after each call: a fresh withLock still works.
        return test.expect(this.lk.withLock(::lockSimple), 41);
    }

    /** Callbacks for lockWithLock. */
    public lockSimple() { return 41; }
    public lockOuter() { return this.lk.withLock(::lockInner); }
    public lockInner() { return "nested"; }
}

/***********************************************************************
 * closure test helpers
 *********************************************************************/

// Fires a supplied callback from a different class with a decoy
// local of the same name in scope. Proves a closure fired through
// its callback sees the captured defining scope, not the invoker's.
class closureRunner {
    public closureRunner() { }

    public fire(callback cb) {
        n = 1000;
        return cb.call();
    }

    public fireWith(callback cb, v) {
        n = 1000;
        return cb.call(v);
    }
}

// Owns closures used for cross-invocation, sibling-call, and
// outside-access tests.
class closureOwner {
    public closureOwner() { }

    // Returns a fresh scope-carrying callback each call. Two calls
    // with different N capture independently.
    public makeAdder(int n) {
        return ::ownerAdd(int x) { return x + n; };
    }

    // Sibling method calls the closure by name with its own locals
    // (the dynamic path from the requirements).
    public callScaleByName() {
        n = 5;
        return this.ownerScale(4);
    }

    public defineScale() {
        n = 2;
        return ::ownerScale(int x) { return x * n; };
    }
}

class closureTests {

    @Test(name = "(closure) Definition expression evaluates to a callback.")
    public closureIsCallback() {
        n = 1;
        scl = ::cloIsCb(int x) { return x * n; };
        return test.expectCallback(scl);
    }

    @Test(name = "(closure) Basic capture of a parent local.")
    public closureBasicCapture() {
        n = 10;
        scl = ::cloScale(int x) { return x * n; };
        return test.expect(scl.call(5), 50);
    }

    @Test(name = "(closure) Captures a parent function argument.")
    public closureCapturesArg() {
        o = new closureOwner();
        add = o.makeAdder(10);
        return test.expect(add.call(5), 15);
    }

    @Test(name = "(closure) Independent captures across invocations.")
    public closureIndependentCaptures() {
        o = new closureOwner();
        addTen = o.makeAdder(10);
        addOne = o.makeAdder(1);
        return test.expect(addTen.call(5) + addOne.call(5), 21);
    }

    @Test(name = "(closure) Assignment inside closure does not leak to parent.")
    public closureAssignIsolated() {
        v = 1;
        f = ::cloSetter() { v = 99; return v; };
        inner = f.call();
        test.expect(inner, 99);
        return test.expect(v, 1);
    }

    @Test(name = "(closure) Mutating a captured list is visible to parent.")
    public closureListMutationShared() {
        lst = [];
        f = ::cloAdder() { lst @= "x"; return true; };
        f.call();
        return test.expect(#lst, 1);
    }

    @Test(name = "(closure) Closure arguments do not appear in parent scope.")
    public closureArgsDontLeak() {
        n = 2;
        f = ::cloArgLeak(int marker) { return marker * n; };
        f.call(21);
        caught = false;
        try { v = marker; } catch (e) { caught = true; }
        return test.expectTrue(caught);
    }

    @Test(name = "(closure) Inline form passed directly as a call argument.")
    public closureInlineArg() {
        n = 3;
        r = new closureRunner();
        return test.expect(r.fireWith(::cloInline(int x) { return x + n; }, 100), 103);
    }

    @Test(name = "(closure) Stored callback fired from another class sees captured scope.")
    public closureFiredElsewhere() {
        n = 7;
        scl = ::cloElsewhere() { return n; };
        r = new closureRunner();
        return test.expect(r.fire(scl), 7);
    }

    @Test(name = "(closure) Direct call by name from the defining function.")
    public closureDirectByName() {
        n = 4;
        scl = ::cloDirect(int x) { return x * n; };
        return test.expect(this.cloDirect(6), 24);
    }

    @Test(name = "(closure) Sibling method call by name sees the sibling's locals.")
    public closureSiblingByName() {
        o = new closureOwner();
        return test.expect(o.callScaleByName(), 20);
    }

    @Test(name = "(closure) Recursion through the hoisted name.")
    public closureRecursion() {
        f = ::cloFact(int x) {
            if (x <= 1) { return 1; }
            return x * this.cloFact(x - 1);
        };
        return test.expect(f.call(5), 120);
    }

    @Test(name = "(closure) Nested closure captures the outer closure's scope.")
    public closureNested() {
        a = 2;
        outer = ::cloNestOuter(int x) {
            b = 3;
            inner = ::cloNestInner(int y) { return y + a + b; };
            return inner.call(x);
        };
        return test.expect(outer.call(1), 6);
    }

    @Test(name = "(closure) Capture is by reference: later parent writes are seen.")
    public closureCaptureByReference() {
        n = 6;
        f = ::cloRefSem() { return n; };
        n = 7;
        return test.expect(f.call(), 7);
    }

    @Test(name = "(closure) Definitions in one invocation share the parent scope.")
    public closureLoopSharedParent() {
        cbs = [];
        for (i = 0; i < 3; i++) {
            n = i * 10;
            cbs @= ::cloLoop() { return n; };
        }
        total = cbs[0].call() + cbs[1].call() + cbs[2].call();
        return test.expect(total, 60);
    }

    @Test(name = "(closure) Overloads by signature at the same closure name.")
    public closureOverloads() {
        f1 = ::cloOv(int x) { return "int:" + x; };
        f2 = ::cloOv(string s) { return "str:" + s; };
        test.expect(this.cloOv(1), "int:1");
        return test.expect(this.cloOv("a"), "str:a");
    }

    @Test(name = "(closure) Typed and default arguments.")
    public closureArgKinds() {
        f = ::cloArgs(int a, b = 5) { return a + b; };
        test.expect(f.call(1), 6);
        return test.expect(f.call(1, 2), 3);
    }

    @Test(name = "(closure) Etcetera arguments.")
    public closureEtcArgs() {
        f = ::cloEtc(int a, ...) { return a + #etc; };
        test.expect(f.call(1), 1);
        return test.expect(f.call(1, 2, 3, 4), 4);
    }

    @Test(name = "(closure) Empty body returns null.")
    public closureEmptyBody() {
        f = ::cloEmpty() { };
        return test.expectNull(f.call());
    }

    @Test(name = "(closure) Call by name from outside the class is denied (private).")
    public closureOutsideByNameDenied() {
        o = new closureOwner();
        ex = "";
        try { o.ownerScale(4); } catch (e) { ex = e.getText(); }
        return test.expectTrue(ex.contains("No access"));
    }

    @Test(name = "(closure) Firing the callback from outside the class succeeds.")
    public closureOutsideCallbackAllowed() {
        o = new closureOwner();
        scl = o.defineScale();
        r = new closureRunner();
        return test.expect(r.fireWith(scl, 4), 8);
    }

    @Test(name = "(closure) ::name on a defined closure captures current locals.")
    public closureRefCaptures() {
        n = 9;
        f = ::cloRefCap() { return n; };
        g = ::cloRefCap;
        r = new closureRunner();
        return test.expect(r.fire(g), 9);
    }

    @Test(name = "(closure) ::name reference works before the definition statement runs.")
    public closureHoistedEarlyRef() {
        r = new closureRunner();
        n = 11;
        g = ::cloEarly;
        early = r.fire(g);
        f = ::cloEarly() { return n; };
        return test.expect(early, 11);
    }

    /***********************************************************************
     * Operator overloading tests.
     *********************************************************************/

    // Helper that builds an opVec with the provided values.
    private mkVec(X, Y) {
        v = new opVec();
        v.setXY(X, Y);
        return v;
    }

    /*
     * Happy path.
     */
    @Test(name = "(operator overloading) Add two objects via __opAdd__.")
    public opOvAddObjects() {
        a = this.mkVec(1, 2);
        b = this.mkVec(10, 20);
        r = a + b;
        return test.expectTrue(r.x == 11 && r.y == 22);
    }

    @Test(name = "(operator overloading) Typed int overload of __opAdd__ wins for int args.")
    public opOvAddTypedInt() {
        a = this.mkVec(1, 2);
        r = a + 5;
        return test.expectTrue(r.x == 6 && r.y == 7);
    }

    @Test(name = "(operator overloading) Subtract, multiply, divide, floor divide, modulus.")
    public opOvArithmetic() {
        a = this.mkVec(10, 20);
        b = this.mkVec(1, 2);
        s = a - b;
        m = a * 3;
        d = a / 2;
        f = a ~/ 3;
        o = a % 3;
        return test.expectTrue(s.x == 9 && s.y == 18 && m.x == 30 && m.y == 60
            && d.x == 5.0 && d.y == 10.0 && f.x == 3 && f.y == 6 && o.x == 1 && o.y == 2);
    }

    @Test(name = "(operator overloading) Reflected multiply: 3 * vec calls __opRightMul__.")
    public opOvReflectedMul() {
        a = this.mkVec(1, 2);
        r = 3 * a;
        return test.expectTrue(r.x == 3 && r.y == 6);
    }

    @Test(name = "(operator overloading) Mirrored comparison: 2 < vec calls vec.__opGt__(2).")
    public opOvMirroredCompare() {
        a = this.mkVec(1, 2);
        return test.expectTrue((2 < a) && !(3 < a) && (3 <= a) && (4 > a) && (3 >= a));
    }

    @Test(name = "(operator overloading) Comparisons between objects use __opLt__ family.")
    public opOvCompareObjects() {
        a = this.mkVec(1, 2);
        b = this.mkVec(10, 20);
        return test.expectTrue((a < b) && (b > a) && (a <= b) && (b >= a) && !(b < a));
    }

    @Test(name = "(operator overloading) Equality via __opEq__ and negated inequality.")
    public opOvEquality() {
        a = this.mkVec(1, 2);
        b = this.mkVec(1, 2);
        d = this.mkVec(9, 9);
        return test.expectTrue((a == b) && !(a == d) && (a != d) && !(a != b));
    }

    @Test(name = "(operator overloading) __opNotEq__ is preferred over negating __opEq__.")
    public opOvNotEqPreferred() {
        a = new opNotEqPref();
        b = new opNotEqPref();
        return test.expect(a != b, "notEqCalled");
    }

    @Test(name = "(operator overloading) __opEq__ may return a non-bool and == passes it through.")
    public opOvEqNonBoolPassThrough() {
        a = new opEqNonBool();
        b = new opEqNonBool();
        return test.expect(a == b, "same");
    }

    @Test(name = "(operator overloading) Unary ! and # call __opNot__ and __opCount__.")
    public opOvUnary() {
        z = this.mkVec(0, 0);
        a = this.mkVec(1, 2);
        return test.expectTrue((!z) && !(!a) && (#a == 2));
    }

    @Test(name = "(operator overloading) @= calls __opInsert__ and returns this.")
    public opOvInsert() {
        a = this.mkVec(1, 2);
        r = (a @= 7);
        (a @= 8) @= 9;
        return test.expectTrue(r.x == 1 && #a.items == 3 && a.items[0] == 7 && a.items[2] == 9);
    }

    @Test(name = "(operator overloading) := calls __opSet__ with a map and yields the left object.")
    public opOvSetMap() {
        v = new opVec();
        r = (v := { "x": 5, "y": 6 });
        r.x = 77;
        return test.expectTrue(v.x == 77 && v.y == 6);
    }

    @Test(name = "(operator overloading) := with __opSet__ accepts a non-map right side.")
    public opOvSetNonMap() {
        a = this.mkVec(3, 4);
        v = new opVec();
        v := a;
        return test.expectTrue(v.x == 3 && v.y == 4);
    }

    @Test(name = "(operator overloading) & and | call __opAnd__ and __opOr__ on objects.")
    public opOvAndOrObjects() {
        a = this.mkVec(1, 0);
        b = this.mkVec(1, 1);
        r1 = a & b;
        r2 = a | b;
        return test.expectTrue(r1.x == 1 && r1.y == 0 && r2.x == 1 && r2.y == 1);
    }

    @Test(name = "(operator overloading) Reflected &: int & vec calls __opRightAnd__.")
    public opOvReflectedAnd() {
        a = this.mkVec(1, 1);
        r = 1 & a;
        return test.expectTrue(r.x == 1 && r.y == 1);
    }

    @Test(name = "(operator overloading) Every reflected method fires with the object on the right.")
    public opOvReflectedAll() {
        o = new opRefl();
        return test.expectTrue((5 + o) == "radd:5" && (5 - o) == "rsub:5"
            && (6 * o) == "rmul:6" && (8 / o) == "rdiv:8" && (9 ~/ o) == "rfdiv:9"
            && (7 % o) == "rmod:7" && (4 & o) == "rand:4" && (4 | o) == "ror:4");
    }

    @Test(name = "(operator overloading) Equality with the overloading object on the right side.")
    public opOvEqualityRightSide() {
        o = new opEqRight();
        n = new opNotEqPref();
        return test.expectTrue((5 == o) && !(6 == o) && !(5 != o) && (6 != o)
            && (1 != n) == "notEqCalled");
    }

    @Test(name = "(operator overloading) __opIndex__ reads with string and int keys.")
    public opOvIndexRead() {
        a = this.mkVec(4, 5);
        return test.expectTrue(a["x"] == 4 && a["y"] == 5 && a[0] == 4 && a[1] == 5);
    }

    @Test(name = "(operator overloading) Chained access through an __opIndex__ result.")
    public opOvIndexChained() {
        a = this.mkVec(4, 5);
        return test.expectTrue(a["list"][0] == 4 && a["list"][1] == 5);
    }

    @Test(name = "(operator overloading) __opIndexSet__ writes with string and int keys.")
    public opOvIndexWrite() {
        a = this.mkVec(1, 2);
        a["x"] = 40;
        a[1] = 50;
        return test.expectTrue(a.x == 40 && a.y == 50);
    }

    @Test(name = "(operator overloading) Compound assignment desugars through __opAdd__.")
    public opOvCompoundAssign() {
        a = this.mkVec(1, 2);
        b = this.mkVec(10, 20);
        a += b;
        return test.expectTrue(a.x == 11 && a.y == 22);
    }

    @Test(name = "(operator overloading) Compound assignment through member, list and map slots.")
    public opOvCompoundSlots() {
        h = new opPlain();
        h.v = this.mkVec(1, 2);
        h.v += this.mkVec(10, 20);
        l = [ this.mkVec(1, 1) ];
        l[0] += this.mkVec(2, 2);
        m = { "k": this.mkVec(5, 5) };
        m["k"] += this.mkVec(1, 1);
        return test.expectTrue(h.v.x == 11 && l[0].x == 3 && m["k"].x == 6);
    }

    @Test(name = "(operator overloading) Compound assignment through an overloaded index.")
    public opOvCompoundIndex() {
        a = this.mkVec(1, 2);
        a["x"] += 5;
        return test.expectTrue(a.x == 6 && a.y == 2);
    }

    @Test(name = "(operator overloading) Operator methods are inherited and overridable.")
    public opOvInheritance() {
        ch = new opChild();
        ch.setXY(1, 2);
        b = this.mkVec(10, 20);
        r = ch + b;
        co = new opChildOverride();
        r2 = co + b;
        return test.expectTrue(r.x == 11 && r2.x == 999);
    }

    @Test(name = "(operator overloading) Operators work in deep expression positions.")
    public opOvDeepPositions() {
        a = this.mkVec(1, 2);
        b = this.mkVec(10, 20);
        lst = [ a + b ];
        cond = false;
        if (a < b) { cond = true; }
        return test.expectTrue(lst[0].mag() == 33 && cond && this.takeMag(a + b) == 33);
    }

    // Non-test helper used by opOvDeepPositions.
    private takeMag(v) {
        return v.mag();
    }

    @Test(name = "(operator overloading) Operator call on an object stored in a collection.")
    public opOvInCollection() {
        lst = [ this.mkVec(1, 2) ];
        r = lst[0] + this.mkVec(10, 20);
        return test.expectTrue(r.x == 11 && r.y == 22);
    }

    @Test(name = "(operator overloading) A private operator method is still called via its operator.")
    public opOvPrivateCall() {
        p = new opPrivateAdd();
        return test.expect(p + 1, 42);
    }

    /*
     * Built-in & and | behavior.
     */
    @Test(name = "(bitwise operators) Int operands produce bitwise results.")
    public opOvBitwiseInts() {
        return test.expectTrue((6 & 3) == 2 && (6 | 3) == 7 && (12 | 1) == 13 && (6&3) == 2);
    }

    @Test(name = "(bitwise operators) Bool operands coerce to 0/1 and return int.")
    public opOvBitwiseBoolCoerce() {
        return test.expectTrue((true & 1) == 1 && (true & true) == 1 && (false | true) == 1 && (false & true) == 0);
    }

    @Test(name = "(bitwise operators) Precedence sits between comparisons and logical operators.")
    public opOvBitwisePrecedence() {
        pr1 = 2 > 1 & 3 > 2;
        pr2 = 1 | 2 & 3;
        pr3 = 4 & 2 && true;
        return test.expectTrue(pr1 == 1 && pr2 == 3 && pr3 == false);
    }

    @Test(name = "(bitwise operators) Non-int operands raise an error naming the operator method.")
    public opOvBitwiseNonInt() {
        ex = "";
        try { r = 1.5 & 2; } catch (e) { ex = e.getText(); }
        return test.expectTrue(ex.contains("requires int operands") && ex.contains("cDouble"));
    }

    @Test(name = "(bitwise operators) The & and | characters still lex inside strings.")
    public opOvBitwiseInStrings() {
        s = "a & b | c";
        return test.expect(#s, 9);
    }

    /*
     * Negative and edge cases.
     */
    @Test(name = "(operator overloading) Plain objects keep today's operator errors, with hints.")
    public opOvPlainErrors() {
        p = new opPlain();
        exSub = "";
        exRightSub = "";
        exCount = "";
        exAnd = "";
        exIdx = "";
        try { r = p - 1; } catch (e) { exSub = e.getText(); }
        try { r = 1 - p; } catch (e) { exRightSub = e.getText(); }
        try { r = #p; } catch (e) { exCount = e.getText(); }
        try { r = p & 1; } catch (e) { exAnd = e.getText(); }
        try { r = p["k"]; } catch (e) { exIdx = e.getText(); }
        return test.expectTrue(exSub.contains("__opSub__") && exRightSub.contains("__opSub__")
            && exCount.contains("__opCount__") && exAnd.contains("__opAnd__")
            && exIdx.contains("doesn't have member"));
    }

    @Test(name = "(operator overloading) Plain objects keep string concatenation for +.")
    public opOvPlainConcat() {
        p = new opPlain();
        r1 = p + 5;
        r2 = "x: " + p;
        return test.expectTrue(#r1 > 0 && #r2 > 3);
    }

    @Test(name = "(operator overloading) __opRightAdd__ takes over string + object when defined.")
    public opOvRightAddString() {
        o = new opRStr();
        return test.expect("x: " + o, "R:x: ");
    }

    @Test(name = "(operator overloading) Signature miss raises FUNCT_NOT_FOUND, no concat fallback.")
    public opOvSignatureMiss() {
        t = new opTypedOnly();
        z = new opZeroArg();
        exTyped = "";
        exZero = "";
        try { r = t + "str"; } catch (e) { exTyped = e.getText(); }
        try { r = z + 1; } catch (e) { exZero = e.getText(); }
        return test.expectTrue((t + 2) == 102 && exTyped.contains("no overload")
            && exTyped.contains("Operator '+'") && exZero.contains("no overload"));
    }

    @Test(name = "(operator overloading) Null right side lands on the wildcard overload.")
    public opOvNullOperand() {
        a = this.mkVec(1, 2);
        r = a + null;
        return test.expectTrue(r.x == -1 && r.y == -1);
    }

    @Test(name = "(operator overloading) Null argument over ambiguous overloads raises the ambiguity error.")
    public opOvNullAmbiguous() {
        na = new opNullAmb();
        ex = "";
        try { r = na + null; } catch (e) { ex = e.getText(); }
        return test.expectTrue(ex.contains("Ambiguous"));
    }

    @Test(name = "(operator overloading) Exceptions from operator methods propagate and are catchable.")
    public opOvThrows() {
        t = new opThrower();
        exAdd = "";
        exMiss = "";
        try { r = t + 1; } catch (e) { exAdd = e.getText(); }
        try { q = ?(t + 1); } catch (e) { exMiss = e.getText(); }
        return test.expectTrue(exAdd.contains("add boom") && exMiss.contains("add boom"));
    }

    @Test(name = "(operator overloading) A failed __opIndexSet__ leaves the target unchanged.")
    public opOvIndexSetThrows() {
        t = new opThrower();
        ex = "";
        try { t["k"] = 5; } catch (e) { ex = e.getText(); }
        return test.expectTrue(ex.contains("set boom") && t.n == 0);
    }

    @Test(name = "(operator overloading) Index write without __opIndexSet__ raises a clear error.")
    public opOvIndexHalfDefined() {
        ro = new opIdxOnly();
        wo = new opIdxSetOnly();
        exWrite = "";
        exRead = "";
        try { ro["k"] = 5; } catch (e) { exWrite = e.getText(); }
        try { r = wo["k"]; } catch (e) { exRead = e.getText(); }
        wo["k"] = 5;
        return test.expectTrue(ro["k"] == 7 && exWrite.contains("__opIndexSet__")
            && exRead.contains("__opIndex__") && wo.last == 5);
    }

    @Test(name = "(operator overloading) __opInsert__ returning non-this documents broken chaining.")
    public opOvInsertBadReturn() {
        ib = new opInsertBad();
        r = (ib @= 1);
        ex = "";
        try { (ib @= 1) @= 2; } catch (e) { ex = e.getText(); }
        return test.expectTrue(r == 7 && ex.contains("not a list"));
    }

    @Test(name = "(operator overloading) != with a non-bool __opEq__ and no __opNotEq__ errors.")
    public opOvNotEqNonBool() {
        a = new opEqNonBool();
        b = new opEqNonBool();
        ex = "";
        try { r = a != b; } catch (e) { ex = e.getText(); }
        return test.expectTrue(ex.contains("__opNotEq__"));
    }

    @Test(name = "(operator overloading) := on plain classes still requires a map.")
    public opOvSetPlainStillMap() {
        p = new opPlain();
        ex = "";
        try { p := 5; } catch (e) { ex = e.getText(); }
        return test.expectTrue(ex.contains("map"));
    }

    /*
     * Regression: short-circuit order of && and || is unchanged.
     */
    @Test(name = "(operator overloading) && and || still short-circuit with side effects.")
    public opOvShortCircuitRegression() {
        sc = new opCounter();
        r1 = sc.bumpFalse() && sc.bumpTrue();
        n1 = sc.n;
        sc2 = new opCounter();
        r2 = sc2.bumpTrue() || sc2.bumpTrue();
        n2 = sc2.n;
        return test.expectTrue(r1 == false && n1 == 1 && r2 == true && n2 == 1);
    }

    @Test(name = "(operator overloading) Primitive operator behavior is unchanged.")
    public opOvPrimitiveRegression() {
        s = "ab" + 1;
        return test.expectTrue((1 + 2) == 3 && (5 - 2) == 3 && (2 * 3) == 6
            && (7 % 3) == 1 && (7 ~/ 2) == 3 && (1 < 2) && ("a" < "b")
            && s == "ab1" && #"abc" == 3 && !false);
    }
}

/***********************************************************************
 * Operator overloading helper classes.
 *********************************************************************/

/**
 * Vector-like class overloading most operators. Comparisons compare
 * by magnitude (x + y) against either another opVec or a number.
 */
class opVec {
    public x = 0;
    public y = 0;
    public items = [];

    public opVec() {}

    public setXY(X, Y) {
        this.x = X;
        this.y = Y;
        return this;
    }

    public mag() {
        return this.x + this.y;
    }

    public __opAdd__(int rhs) {
        r = new opVec();
        return r.setXY(this.x + rhs, this.y + rhs);
    }

    public __opAdd__(rhs) {
        if (rhs == null) {
            // Marker result for the null operand test.
            r = new opVec();
            return r.setXY(-1, -1);
        }
        r = new opVec();
        return r.setXY(this.x + rhs.x, this.y + rhs.y);
    }

    public __opSub__(rhs) {
        r = new opVec();
        return r.setXY(this.x - rhs.x, this.y - rhs.y);
    }

    public __opMul__(int rhs) {
        r = new opVec();
        return r.setXY(this.x * rhs, this.y * rhs);
    }

    public __opRightMul__(int lhs) {
        return this.__opMul__(lhs);
    }

    public __opDiv__(int rhs) {
        r = new opVec();
        return r.setXY(this.x / rhs, this.y / rhs);
    }

    public __opFloorDiv__(int rhs) {
        r = new opVec();
        return r.setXY(this.x ~/ rhs, this.y ~/ rhs);
    }

    public __opMod__(int rhs) {
        r = new opVec();
        return r.setXY(this.x % rhs, this.y % rhs);
    }

    public __opEq__(rhs) {
        if (rhs == null) { return false; }
        return this.mag() == rhs.mag();
    }

    public __opLt__(rhs) {
        if (rhs instanceof "opVec") { return this.mag() < rhs.mag(); }
        return this.mag() < rhs;
    }

    public __opGt__(rhs) {
        if (rhs instanceof "opVec") { return this.mag() > rhs.mag(); }
        return this.mag() > rhs;
    }

    public __opLtEq__(rhs) {
        if (rhs instanceof "opVec") { return this.mag() <= rhs.mag(); }
        return this.mag() <= rhs;
    }

    public __opGtEq__(rhs) {
        if (rhs instanceof "opVec") { return this.mag() >= rhs.mag(); }
        return this.mag() >= rhs;
    }

    public __opNot__() {
        return this.mag() == 0;
    }

    public __opCount__() {
        return 2;
    }

    public __opInsert__(item) {
        this.items @= item;
        return this;
    }

    public __opSet__(init) {
        if (init instanceof "opVec") {
            this.x = init.x;
            this.y = init.y;
        } else {
            this.x = init["x"];
            this.y = init["y"];
        }
    }

    public __opIndex__(key) {
        if (key == "x" || key == 0) { return this.x; }
        if (key == "y" || key == 1) { return this.y; }
        if (key == "list") { return [ this.x, this.y ]; }
        throw "opVec bad key";
    }

    public __opIndexSet__(key, value) {
        if (key == "x" || key == 0) { this.x = value; }
        else if (key == "y" || key == 1) { this.y = value; }
        else { throw "opVec bad set key"; }
    }

    public __opAnd__(rhs) {
        r = new opVec();
        rx = 0;
        ry = 0;
        if (this.x != 0 && rhs.x != 0) { rx = 1; }
        if (this.y != 0 && rhs.y != 0) { ry = 1; }
        return r.setXY(rx, ry);
    }

    public __opOr__(rhs) {
        r = new opVec();
        rx = 0;
        ry = 0;
        if (this.x != 0 || rhs.x != 0) { rx = 1; }
        if (this.y != 0 || rhs.y != 0) { ry = 1; }
        return r.setXY(rx, ry);
    }

    public __opRightAnd__(lhs) {
        r = new opVec();
        rx = 0;
        ry = 0;
        if (lhs != 0 && this.x != 0) { rx = 1; }
        if (lhs != 0 && this.y != 0) { ry = 1; }
        return r.setXY(rx, ry);
    }
}

// Inherits every operator method from opVec.
class opChild : opVec {
    public opChild() {}
}

// Overrides the wildcard __opAdd__ from opVec.
class opChildOverride : opVec {
    public opChildOverride() {}
    public __opAdd__(rhs) {
        r = new opVec();
        return r.setXY(999, 999);
    }
}

// No operator methods at all; used for unchanged-behavior tests.
class opPlain {
    public v = 1;
    public opPlain() {}
}

// Only a typed int overload; other arg types must miss loudly.
class opTypedOnly {
    public opTypedOnly() {}
    public __opAdd__(int rhs) { return 100 + rhs; }
}

// Zero-arg operator method never matches a binary operator call.
class opZeroArg {
    public opZeroArg() {}
    public __opAdd__() { return 0; }
}

// __opEq__ returning a non-bool (elementwise style result).
class opEqNonBool {
    public opEqNonBool() {}
    public __opEq__(rhs) { return "same"; }
}

// Defines both equality methods; __opNotEq__ must win for !=.
class opNotEqPref {
    public opNotEqPref() {}
    public __opEq__(rhs) { return false; }
    public __opNotEq__(rhs) { return "notEqCalled"; }
}

// Two reference-typed overloads make a null argument ambiguous.
class opNullAmb {
    public opNullAmb() {}
    public __opAdd__(string rhs) { return "s"; }
    public __opAdd__(list rhs) { return "l"; }
}

// Operator methods that throw; n proves no partial mutation.
class opThrower {
    public n = 0;
    public opThrower() {}
    public __opAdd__(rhs) { throw "add boom"; }
    public __opIndex__(key) { throw "read boom"; }
    public __opIndexSet__(key, value) { throw "set boom"; }
}

// Read-only overloaded index.
class opIdxOnly {
    public opIdxOnly() {}
    public __opIndex__(key) { return 7; }
}

// Write-only overloaded index.
class opIdxSetOnly {
    public last = null;
    public opIdxSetOnly() {}
    public __opIndexSet__(key, value) { this.last = value; }
}

// __opInsert__ that breaks the return-this convention.
class opInsertBad {
    public opInsertBad() {}
    public __opInsert__(item) { return 7; }
}

// Private operator method; the call documents the access behavior.
class opPrivateAdd {
    public opPrivateAdd() {}
    private __opAdd__(rhs) { return 42; }
}

// Side-effect counter proving && and || still short-circuit.
class opCounter {
    public n = 0;
    public opCounter() {}
    public bumpTrue() { this.n = this.n + 1; return true; }
    public bumpFalse() { this.n = this.n + 1; return false; }
}

// Reflected add on the right side of string + object.
class opRStr {
    public opRStr() {}
    public __opRightAdd__(rhs) { return "R:" + rhs; }
}

// Every reflected method, each returning a tagged string so tests
// can prove exactly which one fired.
class opRefl {
    public opRefl() {}
    public __opRightAdd__(lhs) { return "radd:" + lhs; }
    public __opRightSub__(lhs) { return "rsub:" + lhs; }
    public __opRightMul__(lhs) { return "rmul:" + lhs; }
    public __opRightDiv__(lhs) { return "rdiv:" + lhs; }
    public __opRightFloorDiv__(lhs) { return "rfdiv:" + lhs; }
    public __opRightMod__(lhs) { return "rmod:" + lhs; }
    public __opRightAnd__(lhs) { return "rand:" + lhs; }
    public __opRightOr__(lhs) { return "ror:" + lhs; }
}

// Equality overload used with the object on the right side.
class opEqRight {
    public opEqRight() {}
    public __opEq__(rhs) { return rhs == 5; }
}
