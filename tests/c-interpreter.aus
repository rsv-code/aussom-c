	@Test(name = "(lang SecurityManager) A new object carries its own policy, not the engine's.")
	public secmanInstIsNotEnginePolicy() {
		sman = new SecurityManager();
		// Writing the instance must not change what the running
		// program may do. It is a policy value, not the engine's
		// policy; there is no way to install it into a live engine.
		sman.setProp('os.info.view', true);
		test.expect(sman.getProp('os.info.view'), true);
		return test.expect(secman.getProp('os.info.view'), false);
	}

	// Lists and maps are mutable, so policy goes in and out as a copy.
	// Editing a returned list must not change the engine's policy.
	@Test(name = "(lang secman) getProp returns a copy of a list property.")
	public secmanGetPropIsCopy() {
		n = secman.getProp('aussom.extern.allowed').size();
		secman.getProp('aussom.extern.allowed').add('com.evil.*');
		return test.expect(secman.getProp('aussom.extern.allowed').size(), n);
	}

	@Test(name = "(lang secman) getMap returns copies of list properties.")
	public secmanGetMapIsCopy() {
		n = secman.getProp('aussom.extern.allowed').size();
		secman.getMap()['aussom.extern.allowed'].add('com.evil.*');
		return test.expect(secman.getProp('aussom.extern.allowed').size(), n);
	}

	@Test(name = "(lang SecurityManager) An instance does not share lists with the engine.")
	public secmanInstListIsCopy() {
		n = secman.getProp('aussom.extern.allowed').size();
		sman = new SecurityManager();
		sman.getProp('aussom.extern.allowed').add('com.evil.*');
		sman.setProp('aussom.extern.allowed', sman.getProp('aussom.extern.allowed'));
		test.expect(sman.getProp('aussom.extern.allowed').size(), n);
		return test.expect(secman.getProp('aussom.extern.allowed').size(), n);
	}

