	@Test(name = "(testRunner) Loads add to one runner engine.")
	public testRunnerLoadsAccumulate() {
		r = new testRunner();
		r.loadTestString("trHook", this.trHookSrc());
		r.loadTestString("trMore", "include aunit; @Test(name = \"m\") class trMoreA { @Test(name = \"m\") public m() { return 0; } }");
		// Java lists them in hash map order, so compare them sorted.
		names = r.getTestClasses();
		names.sortAsc();
		return test.expect(names.join(","), "trHookA,trHookB,trMoreA");
	}

