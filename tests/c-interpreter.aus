	@Test(name = "(testRunner) Unknown class or function errors match Java.")
	public testRunnerLookupErrors() {
		r = new testRunner();
		r.loadTestString("trHook", this.trHookSrc());
		ex = '';
		try { r.getTestFunctions("nope"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.getTestFunctions(): Provided class 'nope' not found.") { return test.fail(ex); }
		try { r.hasOnTestFail("nope"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.hasOnTestFail(): Provided class 'nope' not found.") { return test.fail(ex); }
		try { r.runClassTests("nope"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.runClassTests(): Provided class 'nope' not found.") { return test.fail(ex); }
		try { r.getTestTags("trHookA", "helper"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.getTestTags(): Function 'helper' not found on class 'trHookA'.") { return test.fail(ex); }
		try { r.getTestTimeoutMs("trHookA", "helper"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.getTestTimeoutMs(): Function 'helper' not found on class 'trHookA'.") { return test.fail(ex); }
		try { r.shouldRun("trHookA", "helper"); } catch (e) { ex = e.getText(); }
		return test.expect(ex, "testRunner.shouldRun(): Function 'helper' not found on class 'trHookA'.");
	}

	@Test(name = "(testRunner) A throwing @Before or @After ends runClassTests with its exception.")
	public testRunnerHookThrows() {
		r = new testRunner();
		src = "include aunit;\n";
		src += "@Test(name = \"b\") class trBoomB { @Before public b() { throw \"before boom\"; } @Test(name = \"t\") public t() { return 0; } }\n";
		src += "@Test(name = \"a\") class trBoomA { @After public a() { throw \"after boom\"; } @Test(name = \"t\") public t() { return 0; } }\n";
		r.loadTestString("trBoom", src);
		exb = '';
		try { r.runClassTests("trBoomB"); } catch (e) { exb = e.getText(); }
		exa = '';
		try { r.runClassTests("trBoomA"); } catch (e) { exa = e.getText(); }
		return test.expect(exb.contains("before boom") + " " + exa.contains("after boom"), "true true");
	}

