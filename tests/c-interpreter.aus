	public secmanSetPropStoresCopy() {
		sman = new SecurityManager();
		l = ['a'];
		sman.setProp('test.list', l);
		l.add('b');
		return test.expect(sman.getProp('test.list').size(), 1);
	}

	/***********************************************************************
	 * Call depth tests
	 *
	 * Unbounded recursion in this runtime is a native stack overflow,
	 * which kills the process; there is no equivalent of catching a
	 * StackOverflowError after the fact. The depth limit is what turns
	 * it into an ordinary Aussom exception, so these also pin that the
	 * interpreter survives.
	 *********************************************************************/
	// The limit of 1000 calls needs about 1.35 MB of native stack. On a
	// thread with less, the stack guard stops the recursion first with
	// STACK_OVERFLOW. Either is the catchable exception this pins; the
	// call depth limit itself is pinned on a large stack in
	// tests/test_engine.c.
	@Test(name = "(engine) Runaway recursion raises a catchable exception.")
	public callDepthExceeded() {
		id = this.caughtId(::infiniteRecursion);
		return test.expect(id == "CALL_DEPTH_EXCEEDED" || id == "STACK_OVERFLOW", true, "Got: " + id);
	}

	/** Callback for callDepthExceeded. */
	public infiniteRecursion() { this.recurse(1); }

	/** Recurses without a base case. */
	public recurse(int n) { return this.recurse(n + 1); }

	/***********************************************************************
	 * Stack overflow tests
	 *
	 * The interpreter walks code and values by recursion on the native
	 * stack. In Java, running out is a StackOverflowError the engine turns
	 * into a STACK_OVERFLOW exception. In C it would be SIGSEGV, so the
	 * stack guard (include/aussom/stack_guard.h) stops before the stack
	 * runs out and raises STACK_OVERFLOW instead. These run real overflows:
	 * values that contain themselves and data nested far deeper than any
	 * thread's stack can hold, through every path that walks a value.
	 * Each must end in the exception, never a crash or a hang, and the
	 * interpreter must keep working afterward.
	 *
	 * Deep expressions in code are covered in tests/test_engine.c, which
	 * can generate the source. So is printing deeply nested data that
	 * does not contain itself: the printed form is indented one tab per
	 * level, so its size grows with the square of the depth, and on a
	 * large stack reaching the guard takes gigabytes of output (Java has
	 * the same cost, cut short sooner by its smaller stack). The C test
	 * runs it on a small thread stack instead.
	 *********************************************************************/

	/** Runs Cb and returns the id of the exception it raised, or "none". */
	public caughtId(callback Cb) {
		try { Cb.call(); } catch (e) { return e.getId(); }
		return "none";
	}

	/** A list that contains itself. */
	public selfList() { l = [1]; l.add(l); return l; }

	/** A map that contains itself. */
	public selfMap() { m = {"a": 1}; m["self"] = m; return m; }

	/** Lists nested 1,000,000 deep: more than any thread's stack holds.
	 * Built once and shared, since building it takes about a second. */
	public deepList() {
		if (this.deepListCache == null) {
			l = [];
			for (i = 0; i < 1000000; i++) { l = [l]; }
			this.deepListCache = l;
		}
		return this.deepListCache;
	}

	public deepListCache = null;

	public soListToJson() { this.selfList().toJson(); }
	public soMapToJson() { this.selfMap().toJson(); }
	public soListPack() { this.selfList().pack(); }
	public soMapPack() { this.selfMap().pack(); }
	public soListClone() { this.selfList().clone(); }
	public soListConcat() { s = "x" + this.selfList(); }
	public soMapConcat() { s = "x" + this.selfMap(); }
	public soListEquals() { b = (this.selfList() == "x"); }
	public soListThrow() { throw this.selfList(); }
	public soObjConcat() { o = new stackSelfRef(); s = "x" + o; }
	public soDeepToJson() { this.deepList().toJson(); }
	public soDeepPack() { this.deepList().pack(); }
	public soDeepClone() { this.deepList().clone(); }

	@Test(name = "(stack overflow) toJson of a list that contains itself.")
	public stackListToJson() { return test.expect(this.caughtId(::soListToJson), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) toJson of a map that contains itself.")
	public stackMapToJson() { return test.expect(this.caughtId(::soMapToJson), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) pack of a list that contains itself.")
	public stackListPack() { return test.expect(this.caughtId(::soListPack), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) pack of a map that contains itself.")
	public stackMapPack() { return test.expect(this.caughtId(::soMapPack), "STACK_OVERFLOW"); }

	// list.clone is shallow, as ArrayList.clone is, so it does not walk
	// into the list it holds and cannot run out of stack.
	@Test(name = "(stack overflow) clone of a list that contains itself.")
	public stackListClone() { return test.expect(this.caughtId(::soListClone), "none"); }

	@Test(name = "(stack overflow) Concatenating a list that contains itself.")
	public stackListConcat() { return test.expect(this.caughtId(::soListConcat), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) Concatenating a map that contains itself.")
	public stackMapConcat() { return test.expect(this.caughtId(::soMapConcat), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) Comparing a list that contains itself to a string.")
	public stackListEquals() { return test.expect(this.caughtId(::soListEquals), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) Throwing a list that contains itself.")
	public stackListThrow() { return test.expect(this.caughtId(::soListThrow), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) Concatenating an object whose member is itself.")
	public stackObjConcat() { return test.expect(this.caughtId(::soObjConcat), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) Logging a list that contains itself prints nothing and raises.")
	public stackListLog() {
		id = "none";
		try { c.log(this.selfList()); } catch (e) { id = e.getId(); }
		return test.expect(id, "STACK_OVERFLOW");
	}

	@Test(name = "(stack overflow) A list that contains itself as a map key stores nothing.")
	public stackListAsKey() {
		m = {};
		id = "none";
		try { m[this.selfList()] = 1; } catch (e) { id = e.getId(); }
		test.expect(id, "STACK_OVERFLOW");
		return test.expect(#m, 0);
	}

	@Test(name = "(stack overflow) setProp of a list that contains itself stores nothing.")
	public stackSecmanSetProp() {
		sman = new SecurityManager();
		id = "none";
		try { sman.setProp("test.self", this.selfList()); } catch (e) { id = e.getId(); }
		test.expect(id, "STACK_OVERFLOW");
		return test.expectNull(sman.getProp("test.self"));
	}

	@Test(name = "(stack overflow) toJson of lists nested 1,000,000 deep.")
	public stackDeepToJson() { return test.expect(this.caughtId(::soDeepToJson), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) pack of lists nested 1,000,000 deep.")
	public stackDeepPack() { return test.expect(this.caughtId(::soDeepPack), "STACK_OVERFLOW"); }

	@Test(name = "(stack overflow) clone of lists nested 1,000,000 deep.")
	public stackDeepClone() { return test.expect(this.caughtId(::soDeepClone), "none"); }

	@Test(name = "(stack overflow) The exception carries Java's text and the interpreter keeps working.")
	public stackOverflowThenContinue() {
		text = "";
		try { this.selfList().toJson(); } catch (e) { text = e.getText(); }
		test.expectTrue(text.contains("ran out of stack space"), "Got: " + text);
		l = [1, [2, 3], {"a": [4]}];
		test.expect(l.toJson(), '[1,[2,3],{"a":[4]}]');
		return test.expect("" + [1, 2], "" + [1, 2]);
	}

	@Test(name = "(stack overflow) A list printed twice side by side is not mistaken for one that contains itself.")
	public stackSharedNotCycle() {
		inner = [1];
		outer = [inner, inner, {"a": inner}];
		s = "" + outer;
		return test.expect(outer.toJson(), '[[1],[1],{"a":[1]}]');
	}

	// Runs the deepest C work a script can reach (a JSON parse at the
	// nesting limit, regex, number formatting, a sort that calls back
	// into Aussom, toJson and pack) at every level of a runaway
	// recursion, so on some level it runs just above the point where
	// the guard fires. That is the measurement behind the guard's
	// reserve; a reserve too small for this platform crashes here.
	@Test(name = "(stack overflow) Heavy C work near the stack limit ends in an exception, not a crash.")
	public stackReserveHolds() {
		open = ""; close = "";
		for (i = 0; i < 999; i++) { open += "["; close += "]"; }
		this.reserveJson = open + "1" + close;
		id = this.caughtId(::reserveRecurse);
		return test.expect(id == "CALL_DEPTH_EXCEEDED" || id == "STACK_OVERFLOW", true, "Got: " + id);
	}

	public reserveJson = "";

	/** Callback for stackReserveHolds. */
	public reserveRecurse() { this.reserveLevel(0); }

	/** One level of stackReserveHolds' recursion. */
	public reserveLevel(int d) {
		a = json.parse(this.reserveJson);
		m = regex.match("(a|b)*c+(d?)e", "ababababcccde");
		s = "x" + 3.14159 + " " + d + " " + [1, 2.5, {"k": [true, null]}];
		l = [5, 3, 9, 1];
		l.sortCustom(::reserveCmp);
		j = [l, {"x": s}].toJson();
		p = [l, {"x": s}].pack();
		return this.reserveLevel(d + 1) + 1;
	}

	/** Comparator for reserveLevel. */
	public reserveCmp(x, y) { return x - y; }

	/***********************************************************************
	 * Sleep slicing tests
	 *
	 * sys.sleep waits in short slices so a host can cancel or pause a
	 * sleeping program. These pin that slicing did not change what
	 * sleep does from a script's point of view.
	 *********************************************************************/
	// 60 ms rather than something larger: it still crosses the 50 ms
	// default slice, so the multi-slice path is exercised, and the
	// suite does not pay for the rest.
	@Test(name = "(sys) Sleep waits for at least the requested time.")
	public sleepWaitsFullDuration() {
		start = sys.getMills();
		sys.sleep(60);
		return test.expect(sys.getMills() - start >= 60, true);
	}

	@Test(name = "(sys) A negative sleep is refused.")
	public sleepNegativeRefused() {
		return test.expectThrowsMessage(::negativeSleep, "must not be negative");
	}

	/** Callback for sleepNegativeRefused. */
	public negativeSleep() { sys.sleep(0-1); }

	@Test(name = "(engine) The interpreter keeps running after a depth exception.")
	public callDepthRecovers() {
		threw = false;
		try { this.recurse(1); } catch (e) { threw = true; }
		test.expect(threw, true);
		// Ordinary recursion well inside the limit still works, so the
		// depth counter unwound rather than sticking at the limit.
		return test.expect(this.countDown(100), 0);
	}

	/** Bounded recursion used by callDepthRecovers. */
	public countDown(int n) {
		if (n <= 0) { return 0; }
		return this.countDown(n - 1);
	}

    // ---------- Parse errors: thrown errors stop the parse ----------

    @Test(name = "(parse error) A syntax error stops the load; classes before it still load.")
    public parseSyntaxErrorKeepsEarlierClasses() {
        src = "class pseA { @Test(name = \"t\") public t() { return true; } } class pseB { public g( { } }";
        ex = "";
        try { r = new testRunner(); r.loadTestString("pseKeep", src); } catch (e) { ex = e.getText(); }
        return test.expect(ex, "");
    }

    @Test(name = "(parse error) A syntax error before any class leaves no classes to load.")
    public parseSyntaxErrorNoClasses() {
        src = "class pseC { public g( { } } class pseD { }";
        id = ""; ex = "";
        try { r = new testRunner(); r.loadTestString("pseNone", src); } catch (e) { id = e.getId(); ex = e.getText(); }
        if (id != "EXTERN_INVOCATION_TARGET_EXCEPTION") { return test.fail("id: " + id); }
        return test.expect(ex.contains("Engine.runTest(): No classes found for that script file."), true);
    }

    @Test(name = "(parse error) An int literal over the long range stops the parse.")
    public parseIntLiteralOverMax() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pIntMax", "class pim { public f() { x = 9223372036854775808; } }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("pIntMax [1]: PARSE_ERROR: Integer out of bounds. Integer max size is 9223372036854775807. <9223372036854775808>"), true);
    }

    @Test(name = "(parse error) An int literal under the long range stops the parse.")
    public parseIntLiteralUnderMin() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pIntMin", "class pin { public f() { x = -0009223372036854775809; } }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("PARSE_ERROR: Integer out of bounds. Integer min size is -9223372036854775808. <-9223372036854775809>"), true);
    }

    @Test(name = "(parse error) The long range limits themselves parse.")
    public parseIntLiteralLimits() {
        x = 9223372036854775807; y = -9223372036854775808;
        return test.expect(x + "," + y, "9223372036854775807,-9223372036854775808");
    }

    @Test(name = "(parse error) A double literal over the double range stops the parse.")
    public parseDoubleLiteralOverMax() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pDblMax", "class pdm { public f() { x = 2.5e308; } }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("PARSE_ERROR: Double out of bounds. Double max size is 1.7976931348623157E308. <2.5E+308>"), true);
    }

    @Test(name = "(parse error) A double literal under the double range stops the parse.")
    public parseDoubleLiteralUnderMin() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pDblMin", "class pdn { public f() { x = -1e400; } }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("PARSE_ERROR: Double out of bounds. Double min size is 2.2250738585072014E-308. <-1.0E+400>"), true);
    }

    @Test(name = "(parse error) An unknown parameter type stops the parse.")
    public parseUnknownParamType() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pPrim", "class ppt { public f(foo X) { } }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("pPrim [1]: PARSE_ERROR: Expecting primative identifier but found 'foo' instead."), true);
    }

    @Test(name = "(parse error) A duplicate overload stops the parse.")
    public parseDuplicateOverload() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pDup", "class pdo { public f(int a, b = 1) { } public f(int c) { } }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains(" [0]: Duplicate method overload 'f(i)' declared at pDup:1; first declared at pDup:1."), true);
    }

    @Test(name = "(parse error) An extern class that isn't found stops the parse.")
    public parseExternClassNotFound() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pExt", "extern class pec : com.nope.Thing { public pec() { } }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("com.aussom.ast.aussomException: Extern class 'com.nope.Thing' not found."), true);
    }

    @Test(name = "(parse error) An include that isn't found stops the parse.")
    public parseIncludeNotFound() {
        ex = "";
        try { r = new testRunner(); r.loadTestString("pInc", "include nosuch.thing; class pic { }"); } catch (e) { ex = e.getText(); }
        return test.expect(ex.contains("Engine.addInclude(): Couldn't find requested include module 'nosuch/thing.aus'."), true);
    }

    // ---------- Stack trace frames (CallStack) ----------

    @Test(name = "(stack trace) A call pushes a call-site frame and a body frame.")
    public traceCallFrames() {
        st = "";
        try { h = new traceHelper(); h.h1(); } catch (e) { st = e.getStackTrace(); }
        if (!st.contains("] Defined. { traceHelper.h2() }")) { return test.fail("no h2 body frame: " + st); }
        if (!st.contains("] Function called. { traceHelper.h2() }")) { return test.fail("no h2 call frame: " + st); }
        if (!st.contains("] Defined. { traceHelper.h1() }")) { return test.fail("no h1 body frame: " + st); }
        return test.expect(st.contains("] Function called. { traceHelper.h1() }"), true);
    }

    @Test(name = "(stack trace) new pushes a constructor frame below the constructor body.")
    public traceConstructorFrames() {
        st = "";
        try { x = new traceCtor(); } catch (e) { st = e.getStackTrace(); }
        if (!st.contains("] Defined. { traceCtor.traceCtor() }")) { return test.fail("no body frame: " + st); }
        return test.expect(st.contains("] Constructor called. { traceCtor.traceCtor() }"), true);
    }

    @Test(name = "(stack trace) An operator overload pushes an operator frame.")
    public traceOperatorFrame() {
        st = "";
        try { a = new traceOp(); b = a + a; } catch (e) { st = e.getStackTrace(); }
        return test.expect(st.contains("] Operator '+' called. { traceOp.__opAdd__() }"), true);
    }

    @Test(name = "(extern) An exception an extern method returns without an id gets EXTERN_RUNTIME.")
    public externExceptionGetsRuntimeId() {
        id = ""; st = ""; line = -1;
        try { b = new Buffer(-1); } catch (e) { id = e.getId(); st = e.getStackTrace(); line = e.getLineNumber(); }
        if (line < 1) { return test.fail("no line: " + line); }
        if (!st.contains("] Function called. { Buffer.newBuffer() }")) { return test.fail("no call-site trace: " + st); }
        return test.expect(id, "EXTERN_RUNTIME");
    }

    // ---------- Reflection: getMethods / getMembers ----------

    @Test(name = "(reflect) getMethods describes each overload's signature, arguments and annotations.")
    public reflectGetMethodsDetails() {
        ms = reflect.getClassDef("reflWarm").getMethods();
        f = ms["f"][0];
        if (f["signature"] != "i,s,d,i,...") { return test.fail("signature: " + f["signature"]); }
        if (f["isExtern"]) { return test.fail("isExtern"); }
        if (#f["annotations"] != 2) { return test.fail("annotations: " + #f["annotations"]); }
        if (f["annotations"][0]["annotationName"] != "Tag") { return test.fail("annotation name"); }
        if (f["annotations"][0]["annotationArgs"]["name"] != "t1") { return test.fail("annotation arg"); }
        args = f["arguments"];
        if (#args != 5) { return test.fail("argument count: " + #args); }
        if (args[0]["name"] != "a" || args[0]["requiredType"] != "int" || args[0]["hasDefaultValue"]) { return test.fail("arg a"); }
        if (args[1]["defaultValue"] != "x" || args[1]["defaultValueType"] != "string") { return test.fail("arg b"); }
        if (args[2]["requiredType"] != "" || args[2]["defaultValueType"] != "double") { return test.fail("arg c"); }
        if (args[3]["requiredType"] != "int" || args[3]["defaultValueType"] != "null") { return test.fail("arg d"); }
        if (args[4]["name"] != "..." || args[4].containsKey("requiredType")) { return test.fail("etcetera"); }
        return test.expect(#ms["over"], 2);
    }

    @Test(name = "(reflect) getMembers describes each member's type and annotations.")
    public reflectGetMembersDetails() {
        mem = reflect.getClassDef("reflWarm").getMembers()["warmMember"];
        if (mem["type"] != "LIST") { return test.fail("type: " + mem["type"]); }
        return test.expect(mem["annotations"][0]["annotationArgs"]["k"], "v");
    }

    @Test(name = "(reflect) A class not yet instantiated lists only its own methods and members.")
    public reflectColdClassOwnOnly() {
        cd = reflect.getClassDef("reflCold");
        if (cd.getMethods().containsKey("baseOnly")) { return test.fail("inherited method listed"); }
        if (!cd.getMethods().containsKey("coldOnly")) { return test.fail("own method missing"); }
        return test.expect(cd.getMembers().containsKey("baseMember"), false);
    }

    @Test(name = "(reflect) An instantiated class also lists inherited methods and members it does not shadow.")
    public reflectWarmClassInherited() {
        w = new reflWarm();
        cd = reflect.getClassDef("reflWarm");
        ms = cd.getMethods();
        if (!ms.containsKey("baseOnly")) { return test.fail("inherited method missing"); }
        if (!ms.containsKey("toJson")) { return test.fail("object method missing"); }
        if (#ms["over"] != 2) { return test.fail("shadowed overload listed: " + #ms["over"]); }
        return test.expect(cd.getMembers().containsKey("baseMember"), true);
    }

    @Test(name = "(reflect) A class extending only object reports isExtern once instantiated.")
    public reflectExternAfterInit() {
        if (reflect.getClassDef("reflCold").isExtern()) { return test.fail("cold class is extern"); }
        o = new nullDefTyped();
        cd = reflect.getClassDef("nullDefTyped");
        if (!cd.isExtern()) { return test.fail("instantiated class not extern"); }
        return test.expect(cd.getExternClassName(), "com.aussom.types.AussomObject");
    }

    // ---------- Typed null defaults ----------

    @Test(name = "(overload) A typed slot with a null default keeps its type.")
    public nullDefaultKeepsType() {
        o = new nullDefTyped();
        if (o.f() != "f:null" || o.f(5) != "f:5" || o.f(null) != "f:null") { return test.fail("f calls"); }
        id = "";
        try { o.f("s"); } catch (e) { id = e.getId(); }
        return test.expect(id, "FUNCT_NOT_FOUND");
    }

    @Test(name = "(overload) A typed null default and a reference overload make null ambiguous.")
    public nullDefaultAmbiguous() {
        o = new nullDefTyped();
        if (o.g("a") != "g2" || o.g(1) != "g1") { return test.fail("g calls"); }
        id = "";
        try { o.g(null); } catch (e) { id = e.getId(); }
        return test.expect(id, "AMBIGUOUS_OVERLOAD");
    }

    // ---------- Inherited method resolution ----------

    @Test(name = "(inherit) A grandparent's method is merged before the parent's.")
    public inheritGrandparentFirst() {
        k = new resKid();
        return test.expect(k.f(), "gp");
    }

    // ---------- for loops ----------

    @Test(name = "(for) An exception from the collection expression is a FOR_EXCEPTION.")
    public forEachOverException() {
        txt = "";
        try { for (k : {}.noSuchMethod()) { } } catch (e) { txt = e.getId() + ": " + e.getText(); }
        return test.expect(txt, "FOR_EXCEPTION: For loop expecting of type LIST or MAP, found 'cException' instead.");
    }

    @Test(name = "(for) An exception from the init expression is ignored.")
    public forInitExceptionIgnored() {
        ran = 0;
        for (q = {}.noSuchMethod(); ran < 1; ran++) { }
        return test.expect(ran, 1);
    }

    // ---------- Object init (:=) ----------

    @Test(name = "(init) A private member is set through its setter.")
    public initPrivateUsesSetter() {
        t = new initTarget() := { "hidden": 5, "pub": 7 };
        if (t.pub != 7) { return test.fail("pub: " + t.pub); }
        return test.expect(t.getHidden(), 105);
    }

    @Test(name = "(init) A private member with no setter is not found, even from inside the class.")
    public initPrivateNoSetter() {
        t = new initTarget();
        id = ""; txt = "";
        try { t.initSelf(); } catch (e) { id = e.getId(); txt = e.getText(); }
        if (t.getOwn() != 3) { return test.fail("own was set"); }
        if (id != "INIT_VAL_NOT_FOUND") { return test.fail("id: " + id); }
        return test.expect(txt, "astExpression.init(): The provided init value 'own' not found in object 'initTarget'.");
    }

    @Test(name = "(init) A key with no member or setter is not found.")
    public initUnknownKey() {
        txt = "";
        try { t = new initTarget() := { "nope": 1 }; } catch (e) { txt = e.getId() + ": " + e.getText(); }
        return test.expect(txt, "INIT_VAL_NOT_FOUND: astExpression.init(): The provided init value 'nope' not found in object 'initTarget'.");
    }

    @Test(name = "(init) A key shorter than two characters is not found.")
    public initShortKey() {
        txt = "";
        try { m = {}; m := { "a": 1 }; } catch (e) { txt = e.getId() + ": " + e.getText(); }
        return test.expect(txt, "INIT_VAL_NOT_FOUND: astExpression.init(): The provided init value 'a' not found in object 'map'.");
    }

    @Test(name = "(init) A right side that is not a map is not possible.")
    public initRightNotMap() {
        txt = "";
        try { t = new initTarget(); t := 5; } catch (e) { txt = e.getId() + ": " + e.getText(); }
        return test.expect(txt, "INIT_NOT_POSSIBLE: astExpression.init(): Right side of init expression returned invalid type 'cObject', expecting 'map'.");
    }
}

class cConcurrentTests {

    // AtomicLong and LongAdder wrap on overflow in Java.
    @Test(name = "(concurrent) AtomicLong and Counter wrap at max int")
    public atomicLongWraps() {
        a = new AtomicLong(9223372036854775807);
        test.expect(a.incrementAndGet(), -9223372036854775807 - 1);
        cnt = new Counter();
        cnt.add(9223372036854775807);
        cnt.add(5);
        return test.expect(cnt.sum(), -9223372036854775804);
    }
}
