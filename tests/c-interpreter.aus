	@Test(name = "(obj) Object path errors use astObj's messages.")
	public objPathMessages() {
		out = [];
		try { x = nope; } catch (e) { out.add(e.getId() + " " + e.getText()); }
		m = {a: 1};
		try { x = m.zz; } catch (e) { out.add(e.getId() + " " + e.getText()); }
		l = [1];
		try { x = l[5]; } catch (e) { out.add(e.getId() + " " + e.getText()); }
		try { x = l.foo; } catch (e) { out.add(e.getId() + " " + e.getText()); }
		try { x = "abc".foo; } catch (e) { out.add(e.getId() + " " + e.getText()); }
		try { x = c; } catch (e) { out.add(e.getId() + " " + e.getText()); }
		try { x = this[5]; } catch (e) { out.add(e.getId() + " " + e.getText()); }
		return test.expect(out.join("; "),
			"UNDEFINED_NAME astObj.evalObjStart(): Undefined name 'nope'.; " +
			"MAP_MISSING_KEY astObj.evalObj(): Map doesn't have key 'zz'.; " +
			"INDEX_OUT_OF_BOUNDS astObj.evalObj(): Index out of bounds.; " +
			"INDEX_NOT_FOUND astObj.evalObj(): List found but no index found.; " +
			"NO_MEMBER_FOUND astObj.evalObj(): Unmatched object type for 'foo'.; " +
			"NO_OPERATION astObj.evalObjStart(): Static class object found but no child function or property provided.; " +
			"INDEX_NOT_FOUND astObj.evalObj(): Provided index isn't a string value.");
	}

	@Test(name = "(overloads) An ambiguous call lists the candidate overloads.")
	public overloadAmbiguousMessage() {
		o = new ovAmbig();
		out = [];
		try { o.p(1, 2); } catch (e) { out.add(e.getId() + " " + e.getText()); }
		try { o.w(1, 2); } catch (e) { out.add(e.getText()); }
		try { o.v(1, 2, 3); } catch (e) { out.add(e.getText()); }
		return test.expect(out.join("; "),
			"AMBIGUOUS_OVERLOAD Call to 'ovAmbig' is ambiguous between: p(d,i), p(i,d); " +
			"Call to 'ovAmbig' is ambiguous between: w(i,*), w(*,i); " +
			"Call to 'ovAmbig' is ambiguous between: v(*,i,...), v(i,*,...)");
	}

