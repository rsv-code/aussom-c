	@Test(name = "(extern) Null in a typed extern parameter fails as a cast in the method.")
	public externNullArgCast() {
		out = [];
		try { "abc".contains(null); } catch (e) { out.add(e); }
		try { [1].removeAll(null); } catch (e) { out.add(e); }
		try { {}.putAll(null); } catch (e) { out.add(e); }
		res = [];
		for (e : out) {
			t = e.getText();
			res.add(e.getId() == "EXTERN_INVOCATION_TARGET_EXCEPTION"
				&& t.contains("External call, invocation target exception for method '")
				&& t.contains("ClassCastException") && t.contains("AussomNull"));
		}
		return test.expect(res.join(","), "true,true,true");
	}

