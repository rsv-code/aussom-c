/*
 * aussom-c's own interpreter tests.
 *
 * tests/interpreter.aus is a copy of aussom-base's tests/interpreter.aus
 * and must stay identical to it; aussom-base is the reference. Tests that
 * only aussom-c has live here instead. Run with:
 *
 *     ./build/aussomc -t tests/c-interpreter.aus
 */

include aunit;
include math;
include sys;
include util;
include inctest;
include reflect;
include concurrent;


// Classes for the stack trace frame tests.
class traceHelper {
	public traceHelper() { }
	public h1() { return this.h2(); }
	public h2() { throw "deep"; }
}


class traceCtor {
	public traceCtor() { throw "inctor"; }
}


class traceOp {
	public traceOp() { }
	public __opAdd__(Other) { throw "inop"; }
}


// Classes for the reflection (getMethods / getMembers) tests.
class reflBase {
	public baseMember = 1;
	public baseOnly(int a) { return a; }
	public over(string s) { return s; }
}


// Never instantiated: reflection lists only its own definitions.
class reflCold : reflBase {
	public coldMember = 2;
	public coldOnly() { }
}


class reflWarm : reflBase {
	@Note(k = "v")
	public warmMember = [1, 2];
	public reflWarm() { }

	@Tag(name = "t1")
	@Other
	public f(int a, string b = "x", c = 1.5, int d = null, ...) { }
	public over(string s) { return s; }
	public over(int i, double d) { return i; }
}


// Classes for the typed null default tests.
class nullDefTyped {
	public f(int x = null) { return "f:" + x; }
	public g(int x = null) { return "g1"; }
	public g(string s) { return "g2"; }
}


// Classes for the inherited method resolution test. Java merges a
// parent's own parents into a class before the parent's entries.
class resGp { public f() { return "gp"; } }

class resMid : resGp { public f() { return "mid"; } }

class resKid : resMid { }


// Classes for the object init (:=) tests.
class initBase {
	private hidden = 1;
	public setHidden(v) { this.hidden = v + 100; }
	public getHidden() { return this.hidden; }
}


class initTarget : initBase {
	private own = 3;
	public pub = 0;
	public initTarget() { }
	public getOwn() { return this.own; }
	public initSelf() { this := { "own": 9 }; }
}


/** A member that refers to the object itself, for the stack overflow tests. */
class stackSelfRef {
	public me = null;
	public stackSelfRef() { this.me = this; }
}


class cbIdentity {
	public f() { }
	public cb() { return ::f; }
}


/** A one-test class for the test.runTestsForClass test. */
@Test(name = "runTestsForClass sample")
class rtfcSample {
	public rtfcSample() { }

	@Test(name = "(aunit) runTestsForClass sample test.")
	public ok() { return true; }
}


/** Overloads that a call cannot choose between, for the ambiguity
 * message tests. */
class ovAmbig {
	public p(int A, double B) { return 1; }
	public p(double A, int B) { return 2; }
	public w(int A, B) { return 1; }
	public w(A, int B) { return 2; }
	public v(A, int B, ...) { return 1; }
	public v(int A, B, ...) { return 2; }
}


/** A class with two extern parents, which cannot be built. */
class twoExternParents : Date, SecurityManager {
	public twoExternParents() { }
}

/** A script's own SecurityManager binding that skips the C
 * constructor. Its subclass carries the parent object as its extern
 * state, not a security manager. */
extern class secmanBind : com.aussom.stdlib.ASecurityManager {
	public secmanBind() { }
	public extern getProp(string Name);
}
class secmanBindSub : secmanBind { }

/** A script's own Date binding that skips newDate. */
extern class dateBind : com.aussom.stdlib.ADate {
	public dateBind() { }
	public extern getTime();
	public extern setTime(int TimeMills);
}

/** A script's own testRunner binding and its subclass. */
extern class runnerBind : com.aussom.stdlib.ATestRunner {
	public runnerBind() { }
	public extern getTestClasses();
	public extern loadTestString(string Name, string Code);
}
class runnerBindSub : runnerBind { }

/** A script's own testRunner binding whose tag setter takes any
 * value. */
extern class tagsBind : com.aussom.stdlib.ATestRunner {
	public tagsBind() { }
	public extern setIncludeTags(Tags);
	public extern setExcludeTags(Tags);
}

class cInterpreterTests {
	private f9buff = null;

	 // INT64_MIN by -1 traps (SIGFPE) in C; Java wraps the quotient and
	 // returns 0 for the remainder.
	 @Test(name = "(int math) min int ~/ -1 wraps to min int.")
	 public floorDivMinByNegOne() {
		 a = -9223372036854775807 - 1;
		 b = -1;
		 return test.expect(a ~/ b, a);
	 }

	 @Test(name = "(int math) min int % -1 is 0.")
	 public modMinByNegOne() {
		 a = -9223372036854775807 - 1;
		 return test.expect(a % -1, 0);
	 }

	 @Test(name = "(int math) ~/ and % by -1 on ordinary ints.")
	 public divModByNegOne() {
		 return test.expect((7 ~/ -1 == -7) && (-7 ~/ -1 == 7) && (7 % -1 == 0), true);
	 }

	 // Signed overflow is undefined in C; Java wraps.
	 @Test(name = "(int math) max int + 1 wraps to min int.")
	 public intAddWraps() {
		 a = 9223372036854775807;
		 return test.expect(a + 1, -9223372036854775807 - 1);
	 }

	 @Test(name = "(int math) max int ++ wraps to min int.")
	 public intIncWraps() {
		 a = 9223372036854775807;
		 a++;
		 return test.expect(a, -9223372036854775807 - 1);
	 }

	 @Test(name = "(int math) min int - 1 wraps to max int.")
	 public intSubWraps() {
		 a = -9223372036854775807 - 1;
		 return test.expect(a - 1, 9223372036854775807);
	 }

	 @Test(name = "(int math) max int * 2 wraps to -2.")
	 public intMulWraps() {
		 a = 9223372036854775807;
		 return test.expect(a * 2, -2);
	 }

	 @Test(name = "(int math) math.abs of min int is min int.")
	 public intAbsMin() {
		 a = -9223372036854775807 - 1;
		 return test.expect(math.abs(a), a);
	 }

	 // A C cast of an out-of-range double is undefined; Java clamps
	 // and maps NaN to 0.
	 @Test(name = "(double) toInt of a huge double is max int.")
	 public doubleToIntHuge() { return test.expect((1.0e300).toInt(), 9223372036854775807); }

	 @Test(name = "(double) toInt of a huge negative double is min int.")
	 public doubleToIntHugeNeg() { return test.expect((-1.0e300).toInt(), -9223372036854775807 - 1); }

	 @Test(name = "(double) toInt of NaN is 0.")
	 public doubleToIntNaN() { return test.expect(math.sqrt(-1.0).toInt(), 0); }

	 // 1e300 is read as a Double, and AJson refuses anything but a Long
	 // for an int.
	 @Test(name = "(json) unpack of an int written as a double is refused.")
	 public unpackIntHuge() {
		 try { json.unpack("{\"type\":\"int\",\"value\":1e300}"); } catch (e) { return test.expect(e.getText().contains("found 'java.lang.Double'"), true); }
		 return test.expect("no exception", "exception");
	 }

	 @Test(name = "(json) unpack refuses a fractional int.")
	 public unpackIntFraction() {
		 try { json.unpack("{\"type\":\"int\",\"value\":1.5}"); } catch (e) { return true; }
		 return test.expect("no exception", "exception");
	 }

	 @Test(name = "(json) min and max int survive pack and unpack.")
	 public packIntExtremes() {
		 a = 9223372036854775807;
		 b = -9223372036854775807 - 1;
		 return test.expect((json.unpack(a.pack()) == a) && (json.unpack(b.pack()) == b), true);
	 }

	 // A callback names its object with an identity number, as Java's
	 // identityHashCode does, never with address bits.
	 @Test(name = "(callback) String form names the object by a stable identity.")
	 public callbackStrIdentity() {
		 a = new cbIdentity();
		 b = new cbIdentity();
		 sa = "" + a.cb();
		 return test.expect(sa.startsWith("callback cbIdentity@") && sa.endsWith("::f")
			 && sa == "" + a.cb() && sa != "" + b.cb(), true);
	 }

	 // Java re-reads the list size each pass and walks a map's live key
	 // set, so changes made by the body are seen.
	 @Test(name = "(foreach) Clearing a list in the body ends the loop.")
	 public foreachListClear() {
		 l = [1, 2, 3];
		 n = 0;
		 for (v : l) { l.clear(); n++; }
		 return test.expect(n, 1);
	 }

	 @Test(name = "(foreach) Clearing a map in the body ends the loop.")
	 public foreachMapClear() {
		 m = {"a": 1, "b": 2, "c": 3};
		 keys = "";
		 for (k : m) { m.clear(); keys += k + ";"; }
		 return test.expect(keys, "a;");
	 }

	 @Test(name = "(foreach) A map key removed by the body is not visited.")
	 public foreachMapRemove() {
		 m = {"a": 1, "b": 2, "c": 3};
		 keys = "";
		 for (k : m) { m.remove("b"); keys += k + ";"; }
		 return test.expect(keys, "a;c;");
	 }

	@Test(name = "(lang string) String split drops trailing blank sections.")
	public stringSplitTrailing() { return test.expect(#("a,b,,".split(",", true)), 2); }

	// There is deliberately no test here for the regex step budget.
	// Tripping it means doing the work the budget allows, and with no
	// budget configured that is the regex engine's built-in limit of
	// ten million steps, which costs about 200 ms -- more than the
	// whole rest of this suite. A script cannot lower the budget under
	// default policy (securitymanager.property.set is false), so there
	// is no cheap way to reach the path from here. The budget mapping
	// is exercised by hand with a low limit instead.

	// String.substring throws, so the script sees Java's
	// EXTERN_INVOCATION_TARGET_EXCEPTION, whose text names the method
	// and ends with the thrown exception.
	@Test(name = "(lang string) An out of range substr reports what went wrong.")
	public substrOutOfRangeReports() {
		return test.expectThrowsMessage(::substrOutOfRange, "invocation target exception for method 'substr'");
	}

	/** Callback for substrOutOfRangeReports. */
	public substrOutOfRange() { x = "abc".substr(0-5); }

	// Passing the list itself used to wait forever on its own lock.
	@Test(name = "(lang list) removeAll with the list itself empties it.")
	public listRemoveAllSelf() { lst = [ "one", "two" ]; lst.removeAll(lst); return test.expect(#lst, 0); }

	@Test(name = "(lang list) retainAll with the list itself keeps every item.")
	public listRetainAllSelf() { lst = [ "one", "two" ]; lst.retainAll(lst); return test.expect(#lst, 2); }

	@Test(name = "(lang Buffer) Reading a string past the end is refused.")
	public bufferStringPastEnd() {
		this.f9buff = new Buffer(16);
		return test.expectThrowsMessage(::stringPastEnd, "runs past the end of a buffer");
	}

	/** Callback for bufferStringPastEnd. */
	public stringPastEnd() { this.f9buff.getStringAt(64, 0); }

	// Past the int64 millisecond range Java's Instant throws; C must not
	// overflow.
	@Test(name = "(lang Date) addDays past the range throws.")
	public dateAddDaysOutOfRange() {
		d = new Date(); d.setTime(0);
		try { d.addDays(9223372036854775807); } catch (e) {
			return test.expect(d.getTime(), 0);
		}
		return test.expect("no exception", "exception");
	}

	@Test(name = "(lang Date) setHours outside 0-23 throws, as Java's withHour does.")
	public dateSetHoursRange() {
		d = new Date(); d.setTime(0); ex = '';
		try { d.setHours(25); } catch (e) { ex = e.getText(); }
		test.expect(d.getTime(), 0);
		return test.expect(ex.contains("Invalid value for HourOfDay (valid values 0 - 23): 25"), true);
	}

	@Test(name = "(lang Date) A setter argument too large for an int is an error, not wrapped.")
	public dateSetHoursIntCast() {
		d = new Date(); d.setTime(0); ex = '';
		try { d.setHours(4294967301); } catch (e) { ex = e.getText(); }
		return test.expect(ex, "Date.setHours(): Value 4294967301 is larger than the maximum int value 2147483647.");
	}

	@Test(name = "(lang Date) setMinutes and setSeconds outside 0-59 throw.")
	public dateSetMinSecRange() {
		d = new Date(); d.setTime(0); ex = '';
		try { d.setMinutes(60); } catch (e) { ex = e.getText(); }
		test.expect(ex.contains("Invalid value for MinuteOfHour (valid values 0 - 59): 60"), true);
		ex = '';
		try { d.setSeconds(-1); } catch (e) { ex = e.getText(); }
		return test.expect(ex.contains("Invalid value for SecondOfMinute (valid values 0 - 59): -1"), true);
	}

	@Test(name = "(lang Date) setYear and setMonth outside their ranges throw.")
	public dateSetYearMonthRange() {
		d = new Date(); d.setTime(0); ex = '';
		try { d.setYear(1000000000); } catch (e) { ex = e.getText(); }
		test.expect(ex.contains("Invalid value for Year (valid values -999999999 - 999999999): 1000000000"), true);
		ex = '';
		try { d.setMonth(13); } catch (e) { ex = e.getText(); }
		return test.expect(ex.contains("Invalid value for MonthOfYear (valid values 1 - 12): 13"), true);
	}

	@Test(name = "(lang Date) setDayOfMonth throws for a day the month does not have.")
	public dateSetDayOfMonthRange() {
		d = new Date(); d.setTime(0); d.setMonth(2); ex = '';
		try { d.setDayOfMonth(32); } catch (e) { ex = e.getText(); }
		test.expect(ex.contains("Invalid value for DayOfMonth (valid values 1 - 28/31): 32"), true);
		ex = '';
		try { d.setDayOfMonth(30); } catch (e) { ex = e.getText(); }
		test.expect(ex.contains("Invalid date 'FEBRUARY 30'"), true);
		ex = '';
		try { d.setDayOfMonth(29); } catch (e) { ex = e.getText(); }
		return test.expect(ex.contains("Invalid date 'February 29' as '1970' is not a leap year"), true);
	}

	@Test(name = "(lang Date) addYears past the range throws.")
	public dateAddYearsOutOfRange() {
		d = new Date(); d.setTime(0);
		try { d.addYears(9223372036854775807); } catch (e) { return true; }
		return test.expect("no exception", "exception");
	}

	// A Date holds a java.time.Instant (seconds plus nanoseconds), so it
	// reaches well past the range of epoch milliseconds. Only getTime(),
	// which returns milliseconds, overflows there.
	@Test(name = "(lang Date) addMillis past the max millisecond works; getTime overflows.")
	public dateAddMillisPastMaxMillis() {
		d = new Date(); d.setTime(9223372036854775807);
		d.addMillis(1);
		ex = '';
		try { d.getTime(); } catch (e) { ex = e.getText(); }
		return test.expect(ex.contains("long overflow"), true);
	}

	@Test(name = "(lang Date) setHours on the min millisecond works.")
	public dateSetHoursAtMinMillis() {
		d = new Date(); d.setTime(-9223372036854775807 - 1);
		d.setHours(0);
		return test.expect(d.getHours() + " " + d.getYear(), "0 -292275055");
	}

	@Test(name = "(lang Date) the min and max milliseconds print as Java does.")
	public dateExtremesToString() {
		a = new Date(); a.setTime(9223372036854775807);
		b = new Date(); b.setTime(-9223372036854775807 - 1);
		return test.expect(a.toString() + " " + b.toString(),
			"+292278994-08-17T07:12:55.807Z +292275056-05-16T16:47:04.192Z");
	}

	@Test(name = "(lang Date) Years outside 0001 - 9999 print as Java does.")
	public dateYearPrinting() {
		d = new Date(0);
		out = [];
		for (y : [5, -5, 0, 10000, 123456]) {
			d.setYear(y);
			out.add(d.toString().substr(0, 11) + " " + d.format("y|yy|yyy|yyyy|yyyyy"));
		}
		return test.expect(out.join(";"),
			"0005-01-01T 5|05|005|0005|00005;0006-01-01T 6|06|006|0006|00006;" +
			"0001-01-01T 1|01|001|0001|00001;+10000-01-0 10000|00|10000|+10000|10000;" +
			"+123456-01- 123456|56|123456|+123456|+123456");
	}

	@Test(name = "(lang Date) setYear reaches year 999,999,999.")
	public dateSetYearFarFuture() {
		d = new Date(0);
		d.setYear(999999999);
		ex = '';
		try { d.getTime(); } catch (e) { ex = e.getText(); }
		return test.expect(d.toString() + " " + d.getYear() + " " + ex.contains("long overflow"),
			"+999999999-01-01T00:00:00.000Z 999999999 true");
	}

	@Test(name = "(lang Date) Past year 999,999,999 the fields cannot be read.")
	public dateBeyondLocalDateTime() {
		d = new Date(0);
		d.setYear(999999999); d.setMonth(12); d.setDayOfMonth(31);
		d.addDays(1);
		ex = '';
		try { d.getYear(); } catch (e) { ex = e.getText(); }
		return test.expect(ex.contains("Invalid value for EpochDay (valid values -365243219162 - 365241780471): 365241780472"), true);
	}

	@Test(name = "(lang Date) Arithmetic overflow reports Java's errors.")
	public dateArithmeticOverflow() {
		ex = '';
		d = new Date(0);
		try { d.addDays(9223372036854775807); } catch (e) { ex = e.getText(); }
		if (!ex.contains("long overflow")) { return test.fail("addDays: " + ex); }
		try { d.addSeconds(9223372036854775807); } catch (e) { ex = e.getText(); }
		if (!ex.contains("Instant exceeds minimum or maximum instant")) { return test.fail("addSeconds: " + ex); }
		try { d.addMonths(24000000000); } catch (e) { ex = e.getText(); }
		if (!ex.contains("Invalid value for Year (valid values -999999999 - 999999999): 2000001970")) { return test.fail("addMonths: " + ex); }
		d.addMillis(9223372036854775807);
		d.addMillis(9223372036854775807);
		return test.expect(d.toString(), "+584556019-04-03T14:25:51.614Z");
	}

	@Test(name = "(lang Date) now() keeps nanoseconds.")
	public dateNowNanos() {
		d = new Date(); d.now();
		e = d.copy();
		f = new Date(d.getTime());
		// Ten tries, since a now() can land on a whole millisecond.
		for (i = 0; i < 10 && d.isSame(f); i++) { d.now(); f = new Date(d.getTime()); }
		return test.expect(d.format("SSSSSSSSS").length() + " " + d.isSame(f) + " " + e.isSame(e), "9 false true");
	}

	@Test(name = "(lang Date) between follows ChronoUnit.between.")
	public dateBetweenJava() {
		d = new Date(1700000000000); d.addMillis(-1);
		e = new Date(0); e.setYear(2021); e.setMonth(3); e.setDayOfMonth(31); e.setHours(5);
		out = [];
		for (u : ["millis", "seconds", "minutes", "hours", "days", "weeks", "months", "years"]) {
			out.add(e.between(d, u));
		}
		ex = '';
		try { e.between(d, "fortnights"); } catch (x) { ex = x.getText(); }
		return test.expect(out.join(",") + " " + ex,
			"82833199999,82833199,1380553,23009,958,136,31,2 Date.between(): unknown unit 'fortnights'. " +
			"Allowed units are millis, seconds, minutes, hours, days, weeks, months, years.");
	}

	@Test(name = "(lang Date) getWeekOfYear and day names at year edges.")
	public dateWeekEdges() {
		out = [];
		for (ymd : [[2020, 12, 31], [2021, 1, 3], [2024, 12, 30], [2027, 1, 1], [-5, 1, 1], [10000, 6, 15]]) {
			d = new Date(0); d.setYear(ymd[0]); d.setMonth(ymd[1]); d.setDayOfMonth(ymd[2]);
			out.add(d.getWeekOfYear() + d.getDayOfWeekName().substr(0, 3));
		}
		return test.expect(out.join(","), "53THU,53SUN,1MON,53FRI,52SUN,24THU");
	}

	@Test(name = "(lang Date) parse reads yyyy and S as Java does.")
	public dateParseYearFraction() {
		d = new Date(0);
		d.parse("+10000-01-01", "yyyy-MM-dd");
		a = d.toString();
		d.parse("2024-01-01 12:00:00.123456", "yyyy-MM-dd HH:mm:ss.SSSSSS");
		b = d.format("SSSSSSSSS") + " " + d.getTime();
		ex = '';
		try { d.parse("10000-01-01", "yyyy-MM-dd"); } catch (e) { ex = e.getText(); }
		return test.expect(a + " " + b + " " + ex.contains("Date.parse(): Parse exception."),
			"+10000-01-01T00:00:00.000Z 123456000 1704110400123 true");
	}

	@Test(name = "(lang Date) json.unpack reads ISO 8601 as Java does.")
	public dateUnpackIso() {
		a = json.unpack("{\"type\":\"Date\",\"value\":\"+10000-01-01T00:00:00.000Z\"}");
		b = json.unpack("{\"type\":\"Date\",\"value\":\"2024-01-01T10:00:00.123456789+02:00\"}");
		c2 = json.unpack("{\"type\":\"Date\",\"value\":\"2024-01-01T10:00Z\"}");
		ex = '';
		try { json.unpack("{\"type\":\"Date\",\"value\":\"bad\"}"); } catch (e) { ex = e.getText(); }
		return test.expect(a.toString() + " " + b.toString() + " " + b.format("SSSSSSSSS") + " " + c2.toString() + " " +
			ex.contains("json.unpack(): Getting value for key 'value'. Parse exception of String (ISO 8601) with value 'bad'."),
			"+10000-01-01T00:00:00.000Z 2024-01-01T08:00:00.123Z 123456789 2024-01-01T10:00:00.000Z true");
	}

	@Test(name = "(lang Date) between past the range throws.")
	public dateBetweenOutOfRange() {
		a = new Date(); a.setTime(9223372036854775807);
		b = new Date(); b.setTime(-9223372036854775807 - 1);
		try { a.between(b); } catch (e) { return true; }
		return test.expect("no exception", "exception");
	}

	@Test(name = "(lang SecurityManager) A new object starts from the standard properties, not the engine's.")
	public secmanInstStartsFromDefaults() {
		// The test run grants test.mock.spy; a new SecurityManager starts
		// from SecurityManagerImpl's properties, where it is off.
		test.expect(secman.getProp('test.mock.spy'), true);
		sman = new SecurityManager();
		return test.expect(sman.getProp('test.mock.spy'), false);
	}

	@Test(name = "(lang SecurityManager) Setting a property to null removes it.")
	public secmanInstSetNullRemoves() {
		sman = new SecurityManager();
		sman.setProp('secman.test', true);
		sman.setProp('secman.test', null);
		return test.expect(sman.keySet().contains('secman.test'), false);
	}

	@Test(name = "(lang SecurityManager) setProp refuses an object and names its type.")
	public secmanInstSetPropObject() {
		sman = new SecurityManager(); ex = '';
		try { sman.setProp('secman.test', new cbIdentity()); } catch (e) { ex = e.getText(); }
		return test.expect(ex, "securitymanager.setProp(): Expecting simple type, list or map but found 'com.aussom.types.AussomObject' instead.");
	}

	@Test(name = "(lang SecurityManager) setMap stores nothing when one value is refused.")
	public secmanInstSetMapAllOrNothing() {
		sman = new SecurityManager();
		try { sman.setMap({ 'secman.a': 1, 'secman.b': new cbIdentity() }); } catch (e) { }
		return test.expect(sman.keySet().contains('secman.a'), false);
	}

	@Test(name = "(lang secman) secman has no setMap method, as in Java's ASecMan.")
