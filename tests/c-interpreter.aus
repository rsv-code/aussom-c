	// Source for the testRunner hook tests. check() passes only on the
	// first run after runBefore, so it shows which object runTest used.
	public trHookSrc() {
		src = "include aunit;\n";
		src += "@Test(name = \"trHook\")\n";
		src += "class trHookA {\n";
		src += "  public count = 0;\n";
		src += "  @Before public setup() { this.count = 10; }\n";
		src += "  @After public teardown() { if (this.count != 11) { throw \"after saw \" + this.count; } }\n";
		src += "  @Test(name = \"check\") public check() { this.count++; if (this.count != 11) { throw \"count \" + this.count; } return 0; }\n";
		src += "  public helper() { return 1; }\n";
		src += "}\n";
		src += "@Test(name = \"trPlain\")\n";
		src += "class trHookB {\n";
		src += "  @Test(name = \"p\") public p() { return 0; }\n";
		src += "}\n";
		return src;
	}

	@Test(name = "(testRunner) runBefore, runTest and runAfter share one object.")
	public testRunnerHooksShareObject() {
		r = new testRunner();
		r.loadTestString("trHook", this.trHookSrc());
		if (r.runBefore("trHookA") != r) { return test.fail("runBefore did not return the runner"); }
		if (r.runTest("trHookA", "check") != r) { return test.fail("runTest did not return the runner"); }
		if (r.runAfter("trHookA") != r) { return test.fail("runAfter did not return the runner"); }
		ex = '';
		try { r.runTest("trHookA", "check"); } catch (e) { ex = e.getText(); }
		// The test's exception reaches the script wrapped, as in Java.
		return test.expect(ex.contains("count 12"), true);
	}

	@Test(name = "(testRunner) runBefore starts a new object.")
	public testRunnerBeforeResets() {
		r = new testRunner();
		r.loadTestString("trHook", this.trHookSrc());
		r.runBefore("trHookA");
		r.runTest("trHookA", "check");
		r.runBefore("trHookA");
		return test.expect(r.runTest("trHookA", "check") == r, true);
	}

	@Test(name = "(testRunner) runTest, runBefore and runAfter errors match Java.")
	public testRunnerRunErrors() {
		r = new testRunner();
		r.loadTestString("trHook", this.trHookSrc());
		ex = '';
		try { r.runTest("trHookA", "helper"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.runTest(): Provided class 'trHookA' function 'helper' has no @Test annotation.") { return test.fail(ex); }
		try { r.runTest("trHookA", "nofn"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.runTest(): Provided class 'trHookA' has no function 'nofn'.") { return test.fail(ex); }
		try { r.runTest("nope", "check"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.runTest(): Provided class 'nope' not found.") { return test.fail(ex); }
		try { r.runBefore("trHookB"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.hasBefore(): Provided class 'trHookB' has no @Before function set.") { return test.fail(ex); }
		try { r.runAfter("trHookB"); } catch (e) { ex = e.getText(); }
		if (ex != "testRunner.hasAfter(): Provided class 'trHookB' has no @After function set.") { return test.fail(ex); }
		try { r.runAfter("nope"); } catch (e) { ex = e.getText(); }
		return test.expect(ex, "testRunner.hasAfter(): Provided class 'nope' not found.");
	}

	@Test(name = "(testRunner) clearClassObjectCache returns the runner.")
	public testRunnerClearCache() {
		r = new testRunner();
		return test.expect(r.clearClassObjectCache() == r, true);
